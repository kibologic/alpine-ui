import { SwissComponent } from '@kibologic/core';

component EmptyState {
  props = {
    icon: String,
    title: String,
    description: String,
    actionLabel: String,
    onAction: Function as () => void,
  };

  render() {
    const hasAction = !!(this.props.actionLabel && this.props.onAction);
    
    return (
      <div class="aui-empty-state">
        {this.props.icon ? (
          <span class="aui-empty-icon" aria-hidden="true">{this.props.icon}</span>
        ) : null}
        
        {this.props.title ? (
          <div class="aui-empty-title">{this.props.title}</div>
        ) : null}
        
        {this.props.description ? (
          <div class="aui-empty-desc">{this.props.description}</div>
        ) : null}
        
        {hasAction ? (
          <button 
            type="button" 
            class="aui-btn" 
            onclick={() => this.props.onAction && this.props.onAction()}
          >
            {this.props.actionLabel}
          </button>
        ) : null}
      </div>
    );
  }
}
