import { SwissComponent } from '@swissjs/core';

/**
 * ErrorBanner — canonical inline error banner for a page's error state.
 *
 * Props:
 *   message : string   — the error text to display
 *   onRetry : () => void — optional; when provided, shows a "Retry" button
 *
 * Usage:
 *   {this._status === 'error' ? (
 *     <ErrorBanner message={this._error} onRetry={() => this._load()} />
 *   ) : ( ... )}
 */

component ErrorBanner {
  props = {
    message: String,
    onRetry: Function as () => void,
  };

  render() {
    return (
      <div style="margin:12px 20px;padding:11px 16px;display:flex;align-items:center;justify-content:space-between;background:color-mix(in srgb,var(--color-danger) 10%,transparent);border:1px solid color-mix(in srgb,var(--color-danger) 25%,transparent);border-radius:6px;flex-shrink:0;">
        <span style="font-size:13px;color:var(--color-danger);">{this.props.message}</span>
        <button
          type="button"
          onclick={() => this.props.onRetry?.()}
          style={this.props.onRetry ? 'padding:3px 10px;border:1px solid var(--color-danger);background:transparent;color:var(--color-danger);border-radius:4px;font-size:12px;cursor:pointer;flex-shrink:0;' : 'display:none;'}
        >Retry</button>
      </div>
    );
  }
}
