import { SwissComponent } from '@swissjs/core';

component SidePanel {
  props = {
    open: Boolean,
    title: String,
    width: String,
    onclose: Function as () => void,
    renderBody: Function as () => any
  };

  render() {
    const width = this.props.width || '480px';

    return (
      <div class="alp-side-panel-container">
        {this.props.open ? (
          <div class="alp-side-panel-overlay" onclick={() => this.props.onclose?.()}></div>
        ) : null}
        <div
          class={`alp-side-panel ${this.props.open ? 'alp-side-panel--open' : ''}`}
          style={`width: ${width};`}
        >
          <div class="alp-side-panel-header">
            <h3 style="margin: 0; font-size: 1.125rem;">{this.props.title}</h3>
            <button class="alp-btn alp-btn--ghost" onclick={() => this.props.onclose?.()}>✕</button>
          </div>
          <div class="alp-side-panel-body">
            {this.props.renderBody?.()}
          </div>
        </div>
      </div>
    );
  }
}
