import { SwissComponent } from '@swissjs/core';

component Toast {
  props = {
    message: String,
    type: String, // 'success' | 'error' | 'warning' | 'info'
    duration: Number,
    onclose: Function as () => void,
  };

  state { let visible: boolean = true; }

  mount {
    const duration = this.props.duration || 3000;
    if (duration > 0) {
      setTimeout(() => {
        this.close();
      }, duration);
    }
  }

  close() {
    this.visible = false;
    if (this.props.onclose) {
      setTimeout(() => this.props.onclose(), 300); // Wait for transition if any
    }
  }

  getIcon() {
    switch (this.props.type) {
      case 'success': return '✓';
      case 'error': return '✕';
      case 'warning': return '⚠';
      case 'info':
      default: return 'ⓘ';
    }
  }

  render() {
    if (!this.visible) return null;

    const type = this.props.type || 'info';

    return (
      <div class="aui-toast-container">
        <div class={`aui-toast aui-toast--${type}`}>
          <div style="display: flex; align-items: center; gap: 0.75rem;">
            <span style="font-size: 1.25rem;">{this.getIcon()}</span>
            <span>{this.props.message}</span>
          </div>
          <button 
            type="button" 
            onclick={() => this.close()}
            style="background: transparent; border: none; color: inherit; font-size: 1.25rem; cursor: pointer; padding: 0;"
          >✕</button>
        </div>
      </div>
    );
  }
}
