import { SwissComponent } from '@swissjs/core';

component Modal {
  props = {
    open: Boolean,
    title: String,
    size: String,          // 'sm' | 'md' | 'lg' | 'fullscreen'
    onclose: Function as () => void,
    draggable: Boolean,
    renderBody: Function as () => any,
    renderFooter: Function as () => any,
  };

  state { let dragX: number = 0; }
  state { let dragY: number = 0; }
  state { let isDragging: boolean = false; }
  state { let startX: number = 0; }
  state { let startY: number = 0; }

  mount {
    if (typeof window !== 'undefined') {
      window.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Escape' && this.props.open) {
          this.close();
        }
      });

      document.addEventListener('mousemove', (e: MouseEvent) => {
        if (!this.isDragging) return;
        this.dragX = e.clientX - this.startX;
        this.dragY = e.clientY - this.startY;
        this.scheduleUpdate?.();
      });

      document.addEventListener('mouseup', () => {
        if (this.isDragging) {
          this.isDragging = false;
          this.scheduleUpdate?.();
        }
      });
    }
  }

  close() {
    if (this.props.onclose) this.props.onclose();
  }

  handleBackdropClick() {
    // When draggable, backdrop click does NOT close (user might be releasing a drag)
    if (this.props.draggable) return;
    this.close();
  }

  startDrag(e: MouseEvent) {
    if (!this.props.draggable) return;
    this.isDragging = true;
    this.startX = e.clientX - this.dragX;
    this.startY = e.clientY - this.dragY;
    this.scheduleUpdate?.();
  }

  render() {
    if (typeof document !== 'undefined') {
      document.body.style.overflow = this.props.open ? 'hidden' : '';
    }

    if (!this.props.open) return null;

    const size = this.props.size || 'md';
    const isDraggable = !!this.props.draggable;

    return (
      <div
        class="aui-modal-overlay"
        onclick={() => this.handleBackdropClick()}
        role="dialog"
        aria-modal="true"
        aria-label={this.props.title || 'Dialog'}
      >
        <div
          class={`aui-modal aui-modal--${size}${isDraggable ? ' aui-modal--draggable' : ''}`}
          onclick={(e: Event) => e.stopPropagation()}
          style={isDraggable ? `transform: translate(${this.dragX}px, ${this.dragY}px); position: relative;` : ''}
        >
          <div
            class="aui-modal-header"
            onmousedown={(e: MouseEvent) => this.startDrag(e)}
          >
            <h2 class="aui-modal-title">{this.props.title || ''}</h2>
            <button
              type="button"
              class="aui-modal-close"
              onclick={(e: Event) => { e.stopPropagation(); this.close(); }}
              aria-label="Close dialog"
            >✕</button>
          </div>

          <div class="aui-modal-body">
            {this.props.renderBody ? this.props.renderBody() : null}
          </div>

          {this.props.renderFooter ? (
            <div class="aui-modal-footer">
              {this.props.renderFooter()}
            </div>
          ) : null}
        </div>
      </div>
    );
  }
}
