import { SwissComponent } from '@swissjs/core';

component Modal {
  props = {
    open: Boolean,
    title: String,
    size: String,
    // Explicit width override (e.g. "780px") for shapes that don't fit the
    // sm/md/lg/xl scale. Wins over the size class via inline style.
    width: String,
    // Skips Modal's own header/footer chrome entirely and removes body
    // padding, handing 100% of the interior to renderBody() — for modals
    // with a custom multi-region layout (e.g. a two-pane checkout) that
    // don't fit the title+body+footer contract. Backdrop, focus
    // capture/restore, Escape, and backdrop-click-to-close are unchanged;
    // only chrome rendering is skipped, so bodyOnly consumers still get
    // the same shared open/close mechanics as every other Modal.
    bodyOnly: Boolean,
    onclose: Function as () => void,
    onClose: Function as () => void,
    hideClose: Boolean,
    renderBody: Function as () => any,
    renderFooter: Function as () => any,
  };

  _lastFocused: HTMLElement | null = null;

  // Unique per instance — a hardcoded "alp-modal-title" id here duplicates
  // across every mounted Modal on the page (multiple Modal instances are
  // routinely mounted as always-rendered siblings, see the render() note
  // below), which is invalid HTML and breaks aria-labelledby association
  // for all but one of them.
  _titleId: string = `alp-modal-title-${Math.random().toString(36).slice(2)}`;

  _onKeydown = (e: KeyboardEvent) => {
    if (e.key === 'Escape' && this.props.open && !this.props.hideClose) {
      const close = this.props.onclose || this.props.onClose;
      if (close) close();
    }
  };

  mount() {
    if (typeof window !== 'undefined') {
      window.addEventListener('keydown', this._onKeydown);
    }
  }

  unmounted() {
    if (typeof window !== 'undefined') {
      window.removeEventListener('keydown', this._onKeydown);
    }
    this._restoreFocus();
  }

  // Basic focus management: remember what was focused before the modal
  // opened and restore it on close, since none of Alpine's modal
  // implementations trap or restore focus today despite asserting
  // role="dialog" aria-modal="true".
  _captureFocus() {
    if (typeof document !== 'undefined' && !this._lastFocused) {
      this._lastFocused = document.activeElement as HTMLElement;
    }
  }

  _restoreFocus() {
    if (this._lastFocused && typeof this._lastFocused.focus === 'function') {
      this._lastFocused.focus();
    }
    this._lastFocused = null;
  }

  handleClose() {
    const close = this.props.onclose || this.props.onClose;
    if (close) close();
  }

  handleBackdropClick() {
    // A modal opened with hideClose=true is meant to force an action —
    // it must not be dismissable by clicking outside it either, matching
    // the Escape-key guard above. Previously this always closed regardless.
    if (this.props.hideClose) return;
    this.handleClose();
  }

  render() {
    // Always mounted, never `return null` when closed. The swiss-lib
    // renderer replaces a null-returning component's vnode with a fresh
    // placeholder <span data-swiss-null> on every render (see
    // component-rendering.ts) — for a single occasional modal that's
    // mostly harmless, but a page with several Modal instances as siblings
    // (confirmed: PosActiveSession.uix alone has 7) hits this repeatedly on
    // every render, and empirically correlates with a real, reproduced bug:
    // an unrelated sibling component (PosCheckoutModal) silently failing to
    // commit its DOM updates — almost certainly a reconciliation issue
    // triggered by the repeated placeholder swap-in/out disrupting sibling
    // DOM node identity tracking. CSS-driven visibility avoids the
    // placeholder path entirely. Same fix as FloatingWindow.uix and
    // PosCheckoutModal.uix.
    if (!this.props.open) {
      this._restoreFocus();
    } else {
      this._captureFocus();
    }
    const size = this.props.size || 'md';
    const dialogStyle = this.props.width ? `width:${this.props.width};max-width:95vw;` : '';
    const bodyOnly = !!this.props.bodyOnly;
    return (
      <div class="alp-modal-backdrop" style={`display:${this.props.open ? 'flex' : 'none'};`} onclick={() => this.handleBackdropClick()}>
        <div
          class={`alp-modal alp-modal--${size}`}
          style={dialogStyle}
          onclick={(e: Event) => e.stopPropagation()}
          role="dialog"
          aria-modal="true"
          aria-labelledby={bodyOnly ? undefined : this._titleId}
        >
          {!bodyOnly ? (
            <div class="alp-modal-header">
              <h2 class="alp-modal-title" id={this._titleId}>{this.props.title}</h2>
              {!this.props.hideClose ? (
                <button class="alp-modal-close" onclick={() => this.handleClose()} aria-label="Close">✕</button>
              ) : null}
            </div>
          ) : null}
          <div class="alp-modal-body" style={bodyOnly ? 'padding:0;overflow:hidden;display:flex;flex-direction:column;min-height:0;' : ''}>
            {this.props.renderBody ? this.props.renderBody() : this.props.children}
          </div>
          {!bodyOnly && this.props.renderFooter ? (
            <div class="alp-modal-footer">{this.props.renderFooter()}</div>
          ) : null}
        </div>
      </div>
    );
  }
}
