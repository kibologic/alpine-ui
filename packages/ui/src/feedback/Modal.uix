import { SwissComponent } from '@swissjs/core';

component Modal {
  props = {
    open: Boolean,
    title: String,
    size: String,
    onclose: Function as () => void,
    onClose: Function as () => void,
    hideClose: Boolean,
    renderBody: Function as () => any,
    renderFooter: Function as () => any,
  };

  _lastFocused: HTMLElement | null = null;

  _onKeydown = (e: KeyboardEvent) => {
    if (e.key === 'Escape' && this.props.open && !this.props.hideClose) {
      const close = this.props.onclose || this.props.onClose;
      if (close) close();
    }
  };

  mount() {
    if (typeof window !== 'undefined') {
      window.addEventListener('keydown', this._onKeydown);
    }
  }

  unmounted() {
    if (typeof window !== 'undefined') {
      window.removeEventListener('keydown', this._onKeydown);
    }
    this._restoreFocus();
  }

  // Basic focus management: remember what was focused before the modal
  // opened and restore it on close, since none of Alpine's modal
  // implementations trap or restore focus today despite asserting
  // role="dialog" aria-modal="true".
  _captureFocus() {
    if (typeof document !== 'undefined' && !this._lastFocused) {
      this._lastFocused = document.activeElement as HTMLElement;
    }
  }

  _restoreFocus() {
    if (this._lastFocused && typeof this._lastFocused.focus === 'function') {
      this._lastFocused.focus();
    }
    this._lastFocused = null;
  }

  handleClose() {
    const close = this.props.onclose || this.props.onClose;
    if (close) close();
  }

  handleBackdropClick() {
    // A modal opened with hideClose=true is meant to force an action —
    // it must not be dismissable by clicking outside it either, matching
    // the Escape-key guard above. Previously this always closed regardless.
    if (this.props.hideClose) return;
    this.handleClose();
  }

  render() {
    if (!this.props.open) {
      this._restoreFocus();
      return null;
    }
    this._captureFocus();
    const size = this.props.size || 'md';
    return (
      <div class="alp-modal-backdrop" onclick={() => this.handleBackdropClick()}>
        <div
          class={`alp-modal alp-modal--${size}`}
          onclick={(e: Event) => e.stopPropagation()}
          role="dialog"
          aria-modal="true"
          aria-labelledby="alp-modal-title"
        >
          <div class="alp-modal-header">
            <h2 class="alp-modal-title" id="alp-modal-title">{this.props.title}</h2>
            {!this.props.hideClose ? (
              <button class="alp-modal-close" onclick={() => this.handleClose()} aria-label="Close">✕</button>
            ) : null}
          </div>
          <div class="alp-modal-body">
            {this.props.renderBody ? this.props.renderBody() : this.props.children}
          </div>
          {this.props.renderFooter ? (
            <div class="alp-modal-footer">{this.props.renderFooter()}</div>
          ) : null}
        </div>
      </div>
    );
  }
}
