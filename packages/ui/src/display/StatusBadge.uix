import { SwissComponent } from '@swissjs/core';

component StatusBadge {
  props = {
    label: String,
    type: String, // success, warning, danger, info, neutral
    size: String,  // sm, md
  };

  render() {
    const { label, type = 'neutral', size = 'md' } = this.props;
    
    return (
      <span class={`aui-badge aui-badge--${type} aui-badge--${size}`}>
        {label}
      </span>
    );
  }
}
