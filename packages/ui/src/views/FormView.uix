import { SwissComponent } from '@swissjs/core';
import { RecordHeader } from '../layout/RecordHeader.uix';
import { Button } from '../primitives/Button.uix';
import { Tabs } from '../layout/Tabs.uix';

/**
 * FormView Engine
 * Odoo-Style: The "Record Machine".
 * Automates the construction of editing workspaces.
 */
component FormView {
    props = {
        title: String,
        subtitle: String,
        status: String,
        statusVariant: String,
        tabs: Array as () => Array<{ id: string; label: string }>,
        activeTab: String,
        onTabChange: Function,
        onSave: Function,
        onCancel: Function,
        loading: Boolean,
        isDirty: Boolean
    };

    render() {
        const { title, subtitle, status, statusVariant, tabs, activeTab, loading, isDirty } = this.props;

        return (
            <div class="aui-view-container aui-form-view">
                <RecordHeader 
                    title={title} 
                    subtitle={subtitle} 
                    status={status} 
                    statusVariant={statusVariant} 
                    onBack={this.props.onCancel}
                />

                <div class="aui-form-workspace">
                    {tabs && tabs.length > 0 && (
                        <Tabs 
                            tabs={tabs} 
                            active={activeTab} 
                            onchange={(id) => this.props.onTabChange && this.props.onTabChange(id)} 
                        />
                    )}

                    <div class="aui-form-content">
                        {this.children}
                    </div>

                    <div class="aui-form-actions-bar">
                        <Button 
                            label="Save Changes" 
                            disabled={!isDirty || loading} 
                            loading={loading}
                            onclick={() => this.props.onSave && this.props.onSave()}
                        />
                        <Button 
                            label="Discard" 
                            variant="outline" 
                            onclick={() => this.props.onCancel && this.props.onCancel()}
                        />
                    </div>
                </div>
            </div>
        );
    }
}
