import { SwissComponent } from '@swissjs/core';

/*
  props:
    charts  — [{ id, title, type: 'bar'|'line'|'pie'|'donut', data, options? }]
    loading — Boolean
    cols    — 1|2|3  (grid columns, default 2)
*/

component AnalyticsView {
  props = {
    charts:  Array,
    loading: Boolean,
    cols:    Number,
  };

  _chartInstances: any = {};

  mounted() { setTimeout(() => this._initCharts(), 60); }
  updated() { setTimeout(() => this._initCharts(), 60); }

  unmounted() {
    Object.keys(this._chartInstances).forEach((k: any) => {
      try { this._chartInstances[k].dispose(); } catch (_) {}
    });
    this._chartInstances = {};
  }

  _css(prop: string) {
    return getComputedStyle(document.documentElement).getPropertyValue(prop).trim();
  }

  _buildOption(cfg: any) {
    const text    = this._css('--color-text-secondary') || '#aaa';
    const grid    = this._css('--color-bg-border')      || '#2a2a2a';
    const accent  = this._css('--color-accent')         || '#6366f1';
    const palette = ['#6366f1','#22c55e','#f59e0b','#ef4444','#3b82f6','#8b5cf6','#06b6d4'];
    const tip     = { backgroundColor: 'rgba(0,0,0,0.72)', textStyle: { color: '#fff', fontSize: 11 } };
    const ax      = (type: string) => ({
      type,
      axisLabel: { color: text, fontSize: 10 },
      axisLine:  { lineStyle: { color: grid } },
      splitLine: { lineStyle: { color: grid } },
    });

    if (cfg.type === 'bar') return {
      tooltip: { ...tip, trigger: 'axis' },
      color: palette,
      grid: { left: 40, right: 16, top: 16, bottom: 32, containLabel: true },
      xAxis: { ...ax('category'), data: cfg.data?.xAxis || [], splitLine: { show: false } },
      yAxis: ax('value'),
      series: (cfg.data?.series || []).map((s: any) => ({
        type: 'bar', barMaxWidth: 40,
        itemStyle: { borderRadius: [3, 3, 0, 0] }, ...s,
      })),
    };

    if (cfg.type === 'line') return {
      tooltip: { ...tip, trigger: 'axis' },
      color: palette,
      grid: { left: 40, right: 16, top: 16, bottom: 32, containLabel: true },
      xAxis: { ...ax('category'), data: cfg.data?.xAxis || [] },
      yAxis: ax('value'),
      series: (cfg.data?.series || []).map((s: any) => ({
        type: 'line', smooth: true,
        lineStyle: { width: 2 }, areaStyle: { opacity: 0.08 }, ...s,
      })),
    };

    if (cfg.type === 'pie' || cfg.type === 'donut') {
      const radius = cfg.type === 'donut' ? ['42%', '68%'] : '62%';
      return {
        tooltip: { ...tip, trigger: 'item', formatter: '{b}: {c} ({d}%)' },
        legend: { bottom: 4, textStyle: { color: text, fontSize: 10 } },
        color: palette,
        series: (cfg.data?.series || []).map((s: any) => ({
          type: 'pie', radius, center: ['50%', '46%'],
          label: { show: false },
          emphasis: { label: { show: true, fontSize: 12 } }, ...s,
        })),
      };
    }

    return cfg.options || {};
  }

  _initCharts() {
    const charts  = this.props.charts || [];
    const echarts = (window as any).echarts;
    if (!echarts) return;
    charts.forEach((cfg: any) => {
      const el = document.getElementById(`alp-chart-${cfg.id}`);
      if (!el) return;
      if (!this._chartInstances[cfg.id]) {
        this._chartInstances[cfg.id] = echarts.init(el, null, { renderer: 'canvas' });
      }
      this._chartInstances[cfg.id].setOption(this._buildOption(cfg), true);
    });
  }

  render() {
    const charts  = this.props.charts || [];
    const loading = !!this.props.loading;
    const cols    = Math.min(Math.max(Number(this.props.cols) || 2, 1), 3);

    if (loading) {
      return (
        <div class="alp-analytics" style={`grid-template-columns:repeat(${cols},1fr)`}>
          {[1,2].map((_: any) => (
            <div class="alp-analytics-chart">
              <div class="alp-skeleton" style="width:40%;height:12px;border-radius:4px;margin-bottom:12px;"></div>
              <div class="alp-analytics-chart-canvas alp-skeleton"></div>
            </div>
          ))}
        </div>
      );
    }

    if (!charts.length) {
      return (
        <div class="alp-analytics-empty">No charts configured</div>
      );
    }

    const hasEcharts = !!(window as any).echarts;

    return (
      <div class="alp-analytics" style={`grid-template-columns:repeat(${cols},1fr)`}>
        {charts.map((cfg: any) => (
          <div class="alp-analytics-chart">
            <div class="alp-analytics-chart-title">{cfg.title}</div>
            {hasEcharts ? (
              <div id={`alp-chart-${cfg.id}`} class="alp-analytics-chart-canvas"></div>
            ) : (
              <div class="alp-analytics-no-echarts">ECharts not loaded — add echarts CDN to index.html</div>
            )}
          </div>
        ))}
      </div>
    );
  }
}
