import { SwissComponent } from '@kibologic/core';

component DashboardGrid {
  props = {
    layout: Object as {
      cols: number;
      gap: string;
      widgets: Array<{
        id: string;
        col: number;
        row: number;
        colSpan: number;
        rowSpan: number;
      }>;
    },
    renderWidget: Function as (id: string, def: any) => any,
    editable: Boolean,
  };

  render() {
    const layout = this.props.layout || { cols: 12, gap: '16px', widgets: [] };
    const cols   = layout.cols    || 12;
    const gap    = layout.gap     || '16px';
    const widgets: any[] = layout.widgets || [];

    return (
      <div
        class={`alp-dash-grid${this.props.editable ? ' alp-dash-grid--editable' : ''}`}
        style={`--dash-cols:${cols}; gap:${gap};`}
      >
        {widgets.map((w: any) => (
          <div
            class="alp-dash-cell"
            style={`grid-column:${w.col} / span ${w.colSpan || 1};grid-row:${w.row} / span ${w.rowSpan || 1};`}
            key={w.id}
          >
            {this.props.renderWidget?.(w.id, w)}
          </div>
        ))}
      </div>
    );
  }
}
