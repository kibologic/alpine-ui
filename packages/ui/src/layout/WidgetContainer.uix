import { SwissComponent } from '@kibologic/core';

component WidgetContainer {
  props = {
    title: String,
    loading: Boolean,
    error: String,
    renderActions: Function as () => any,
    renderContent: Function as () => any,
  };

  render() {
    return (
      <div class="alp-widget">
        <div class="alp-widget-header">
          <span class="alp-widget-title">{this.props.title}</span>
          {this.props.renderActions && (
            <div class="alp-widget-actions">{this.props.renderActions()}</div>
          )}
        </div>
        <div class="alp-widget-body">
          {this.props.loading ? (
            <div class="alp-widget-loading">
              <span class="alp-spinner alp-spinner--sm"></span>
            </div>
          ) : this.props.error ? (
            <div class="alp-widget-error">{this.props.error}</div>
          ) : (
            this.props.renderContent?.()
          )}
        </div>
      </div>
    );
  }
}
