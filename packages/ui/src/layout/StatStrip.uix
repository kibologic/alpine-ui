import { SwissComponent } from '@swissjs/core';
import { KpiCard } from '../widgets/KpiCard.uix';

interface StatItem {
  label:      string;
  value:      string;
  delta?:     string;
  deltaType?: string;
  comparison?: string;
  sparkline?: number[];
  info?:      string;
}

component StatStrip {
  props = {
    stats: Array as () => StatItem[],
  };

  render() {
    const stats: StatItem[] = Array.isArray(this.props.stats) ? this.props.stats as StatItem[] : [];
    return (
      <div class="alp-stat-strip">
        {stats.map((s: StatItem) => (
          <KpiCard
            key={s.label}
            label={s.label}
            value={s.value}
            delta={s.delta}
            deltaType={s.deltaType}
            comparison={s.comparison}
            sparkline={s.sparkline}
            info={s.info}
          />
        ))}
      </div>
    );
  }
}
