import { SwissComponent } from '@swissjs/core';

/*
  props:
    title        — page title string
    subtitle     — page subtitle string
    views        — [{ id, label, icon? }] — omit or [] to hide view switcher
    activeView   — current view id
    onViewChange — (id: string) => void
    filters      — [{ key, label, options:[{value,label}], value, onChange }]
    actions      — [{ label, onClick, primary?, perm?, disabled? }]
    onRefresh    — () => void — registers with the shell topbar refresh button
    loading      — Boolean
*/

component WorkspaceHeader {
  props = {
    title:        String,
    subtitle:     String,
    views:        Array,
    activeView:   String,
    onViewChange: Function,
    filters:      Array,
    actions:      Array,
    onRefresh:    Function,
    loading:      Boolean,
  };

  state { let showViewMenu:    boolean = false; }
  state { let showActionsMenu: boolean = false; }

  _uid: string = `wsh_${Math.random().toString(36).slice(2)}`;

  mounted() {
    if (this.props.onRefresh) {
      const uid = this._uid;
      const cb  = this.props.onRefresh;

      const _registerIfVisible = () => {
        const el = document.querySelector(`[data-wsh-uid="${uid}"]`);
        if (!el || (el as HTMLElement).offsetParent === null) return;
        const _ws  = (window as any).__skltn?.registry?.get('workspace');
        const _tab = _ws?.getActive?.();
        if (_tab?.id) {
          if (!(window as any).__alpRefresh) (window as any).__alpRefresh = {};
          (window as any).__alpRefresh[_tab.id] = cb;
        }
      };

      _registerIfVisible();
      setTimeout(_registerIfVisible, 100);
      setTimeout(_registerIfVisible, 400);

      const eb = (window as any).__skltn?.registry?.get('event-bus');
      if (eb) eb.on('workspace:activated', _registerIfVisible);
    }

    document.addEventListener('click', (e: any) => {
      if (!e.target.closest('.alp-ws-hdr-drop')) {
        if (this.showViewMenu || this.showActionsMenu) {
          this.showViewMenu    = false;
          this.showActionsMenu = false;
        }
      }
    });
  }

  render() {
    const views   = this.props.views   || [];
    const filters = this.props.filters || [];
    const actions = this.props.actions || [];
    const loading = !!this.props.loading;
    const av      = this.props.activeView || (views[0]?.id ?? '');
    const avLabel = views.find((v: any) => v.id === av)?.label || 'View';

    return (
      <div class="alp-ws-hdr" data-wsh-uid={this._uid}>

        <div class="alp-ws-hdr-left">
          {this.props.title    ? <span class="alp-ws-hdr-title">{this.props.title}</span>    : null}
          {this.props.subtitle ? <span class="alp-ws-hdr-sub">{this.props.subtitle}</span> : null}
        </div>

        <div class="alp-ws-hdr-right">

          {/* ── View switcher ── */}
          {views.length > 1 ? (
            <div class="alp-ws-hdr-drop">
              <button
                class={`alp-ws-hdr-btn ${this.showViewMenu ? 'alp-ws-hdr-btn--open' : ''}`}
                onclick={() => { this.showViewMenu = !this.showViewMenu; this.showActionsMenu = false; }}
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="13" height="13">
                  <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
                  <rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
                </svg>
                <span>{avLabel}</span>
                <svg viewBox="0 0 20 20" fill="currentColor" width="11" height="11">
                  <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
                </svg>
              </button>
              {this.showViewMenu ? (
                <div class="alp-ws-hdr-panel" onclick={(e: any) => e.stopPropagation()}>
                  {views.map((v: any) => (
                    <button
                      class={`alp-ws-hdr-panel-item ${av === v.id ? 'alp-ws-hdr-panel-item--active' : ''}`}
                      onclick={() => { this.props.onViewChange?.(v.id); this.showViewMenu = false; }}
                    >{v.label}</button>
                  ))}
                </div>
              ) : null}
            </div>
          ) : null}

          {/* ── Filters ── */}
          {filters.map((f: any) => (
            <select
              class="alp-input alp-input--sm"
              style="min-width:130px;height:30px;"
              onchange={(e: any) => f.onChange?.(e.target.value)}
            >
              <option value="">{f.label || 'All'}</option>
              {(f.options || []).map((o: any) => (
                <option value={o.value} selected={f.value === o.value}>{o.label}</option>
              ))}
            </select>
          ))}

          {/* ── Actions dropdown ── */}
          {actions.length > 0 ? (
            <div class="alp-ws-hdr-drop">
              <button
                class={`alp-ws-hdr-btn alp-ws-hdr-btn--accent ${this.showActionsMenu ? 'alp-ws-hdr-btn--open' : ''}`}
                onclick={() => { this.showActionsMenu = !this.showActionsMenu; this.showViewMenu = false; }}
              >
                <span>Actions</span>
                <svg viewBox="0 0 20 20" fill="currentColor" width="11" height="11">
                  <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
                </svg>
              </button>
              {this.showActionsMenu ? (
                <div class="alp-ws-hdr-panel alp-ws-hdr-panel--right" onclick={(e: any) => e.stopPropagation()}>
                  {actions.map((a: any) => {
                    const hasPerm = !a.perm || !!(window as any).__skltn?.can(a.perm);
                    if (!hasPerm) return null;
                    return (
                      <button
                        class={`alp-ws-hdr-panel-item ${a.primary ? 'alp-ws-hdr-panel-item--primary' : ''}`}
                        disabled={!!a.disabled}
                        onclick={() => { a.onClick?.(); this.showActionsMenu = false; }}
                      >{a.label}</button>
                    );
                  })}
                </div>
              ) : null}
            </div>
          ) : null}

        </div>
      </div>
    );
  }
}
