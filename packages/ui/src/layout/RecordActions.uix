import { SwissComponent } from '@swissjs/core';

/*
  RecordActions — canonical "Actions" dropdown for record/detail-page
  headers, visually matching WorkspaceHeader's list-view Actions button
  so a page feels consistent switching between its list and record views.

  Replaces spreading individual action buttons (Edit, Delete, ...) across
  the header — those become dropdown items instead.

  props:
    actions — [{ label, onClick, primary?, danger?, disabled? }]
*/

interface RecordAction {
  label:    string;
  onClick?: () => void;
  primary?: boolean;
  danger?:  boolean;
  disabled?: boolean;
}

component RecordActions {
  props = {
    actions: Array as () => RecordAction[],
  };

  state { let open: boolean = false; }

  _onDocClick = (e: MouseEvent) => {
    if (!(e.target as HTMLElement).closest('.alp-ws-hdr-drop')) {
      this.open = false;
    }
  };

  _onKeydown = (e: KeyboardEvent) => {
    if (e.key === 'Escape') this.open = false;
  };

  mounted() {
    document.addEventListener('click', this._onDocClick);
    window.addEventListener('keydown', this._onKeydown);
  }

  unmounted() {
    document.removeEventListener('click', this._onDocClick);
    window.removeEventListener('keydown', this._onKeydown);
  }

  render() {
    const actions: RecordAction[] = this.props.actions || [];
    if (!actions.length) return null;

    return (
      <div class="alp-ws-hdr-drop">
        <button
          class={`alp-ws-hdr-btn alp-ws-hdr-btn--accent ${this.open ? 'alp-ws-hdr-btn--open' : ''}`}
          onclick={() => { this.open = !this.open; }}
        >
          <span>Actions</span>
          <svg viewBox="0 0 20 20" fill="currentColor" width="11" height="11">
            <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
          </svg>
        </button>
        <div
          class="alp-ws-hdr-panel alp-ws-hdr-panel--right"
          style={this.open ? '' : 'display:none;'}
          onclick={(e: MouseEvent) => e.stopPropagation()}
        >
          {actions.map((a: RecordAction) => (
            <button
              key={a.label}
              class={`alp-ws-hdr-panel-item ${a.primary ? 'alp-ws-hdr-panel-item--primary' : ''} ${a.danger ? 'alp-ws-hdr-panel-item--danger' : ''}`}
              disabled={!!a.disabled}
              onclick={() => { a.onClick?.(); this.open = false; }}
            >{a.label}</button>
          ))}
        </div>
      </div>
    );
  }
}
