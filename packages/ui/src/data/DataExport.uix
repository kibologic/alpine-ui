import { SwissComponent } from '@kibologic/core';

component DataExport {
  props = {
    data: Array as () => Array<Record<string, any>>,
    columns: Array as () => Array<{ key: string; label: string }>,
    filename: String,
  };

  async handleExport() {
    try {
      if (!window.XLSX) {
        // Dynamically load SheetJS if not present
        const script = document.createElement('script');
        script.src = 'https://cdn.sheetjs.com/xlsx-latest/package/dist/xlsx.full.min.js';
        document.head.appendChild(script);
        await new Promise((resolve) => {
          script.onload = resolve;
        });
      }

      const rawData = Array.isArray(this.props.data) ? this.props.data : [];
      const columns = Array.isArray(this.props.columns) ? this.props.columns : [];
      
      const fileData = rawData.map(row => {
        const outRow: Record<string, any> = {};
        columns.forEach(col => {
          outRow[col.label] = row[col.key];
        });
        return outRow;
      });

      const ws = window.XLSX.utils.json_to_sheet(fileData);
      const wb = window.XLSX.utils.book_new();
      window.XLSX.utils.book_append_sheet(wb, ws, "Data");
      const filename = this.props.filename ? `${this.props.filename}.xlsx` : 'export.xlsx';
      window.XLSX.writeFile(wb, filename);

    } catch (e) {
      console.error('Export failed', e);
      alert('Failed to export data.');
    }
  }

  render() {
    return (
      <button 
        type="button" 
        class="aui-btn aui-btn--outline" 
        onclick={() => this.handleExport()}
      >
        Export
      </button>
    );
  }
}
