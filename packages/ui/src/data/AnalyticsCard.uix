import { SwissComponent } from '@swissjs/core';

/*
  AnalyticsCard — canonical, reusable analytics widget.

  Pure presentation: receives `data` + `config` and renders an ECharts
  visualisation with a standard header (title/rename, last-refreshed,
  loading, overflow menu). Every config mutation is reported upward via
  `onConfigChange` — this component never persists anything itself and
  never makes API calls (persistence is the consuming page's job, see
  the analytics widget config helpers in @kibologic/erp-core).

  Props:
    id              String    — widget instance id (DOM ids only, not persistence)
    title           String
    subtitle        String
    data            Object    — dataset, shape depends on config.chartType (see CHART_TYPES below)
    config          Object    — { chartType, showLegend, showLabels, showTooltips, animations, colorPalette, customTitle }
    onConfigChange  Function  — (config: object | null) => void. null means "reset to defaults".
    availableTypes  Array     — string[] restricting the chart-type picker; default = full registry
    loading         Boolean
    lastRefreshed   String    — already-formatted display string, e.g. "2 min ago"
    onRefresh       Function  — () => void
    onExportDataset Function  — () => Array<Record<string, unknown>>
    onDelete        Function  — () => void (menu item only shown if provided)
    onLiveUpdate    Function  — (point: unknown) => void — forward-compat hook, not wired yet
    height          String    — default '320px'
*/

const DEFAULT_CONFIG = {
  chartType: 'bar',
  showLegend: true,
  showLabels: false,
  showTooltips: true,
  animations: true,
  colorPalette: 'default',
  customTitle: null,
};

const PALETTES: Record<string, string[]> = {
  default: ['#6366f1', '#22c55e', '#f59e0b', '#ef4444', '#3b82f6', '#8b5cf6', '#06b6d4'],
  cool:    ['#3b82f6', '#6366f1', '#8b5cf6', '#06b6d4', '#0ea5e9', '#14b8a6', '#818cf8'],
  warm:    ['#f59e0b', '#ef4444', '#f97316', '#eab308', '#fb7185', '#f43f5e', '#fbbf24'],
  mono:    ['#6366f1', '#818cf8', '#a5b4fc', '#4f46e5', '#c7d2fe', '#4338ca', '#e0e7ff'],
};

const CHART_TYPES: Array<{ id: string; label: string; category: string; disabled?: boolean }> = [
  { id: 'bar',                 label: 'Bar Chart',            category: 'Comparison' },
  { id: 'horizontal-bar',      label: 'Horizontal Bar',       category: 'Comparison' },
  { id: 'grouped-bar',         label: 'Grouped Bar',          category: 'Comparison' },
  { id: 'stacked-bar',         label: 'Stacked Bar',          category: 'Comparison' },
  { id: 'percent-stacked-bar', label: '100% Stacked Bar',     category: 'Comparison' },

  { id: 'line',                label: 'Line Chart',           category: 'Trends' },
  { id: 'multi-line',          label: 'Multi-Line',           category: 'Trends' },
  { id: 'area',                label: 'Area Chart',           category: 'Trends' },
  { id: 'stacked-area',        label: 'Stacked Area',         category: 'Trends' },
  { id: 'step-line',           label: 'Step Line',            category: 'Trends' },

  { id: 'histogram',           label: 'Histogram',            category: 'Distribution' },
  { id: 'boxplot',             label: 'Box Plot',             category: 'Distribution' },
  { id: 'violin',              label: 'Violin Plot',          category: 'Distribution', disabled: true },

  { id: 'pie',                 label: 'Pie Chart',            category: 'Proportion' },
  { id: 'donut',               label: 'Donut Chart',          category: 'Proportion' },
  { id: 'nested-donut',        label: 'Nested Donut',         category: 'Proportion' },
  { id: 'polar-area',          label: 'Polar Area',           category: 'Proportion' },

  { id: 'scatter',             label: 'Scatter Plot',         category: 'Relationships' },
  { id: 'bubble',              label: 'Bubble Chart',         category: 'Relationships' },
  { id: 'heatmap',             label: 'Heatmap',              category: 'Relationships' },

  { id: 'treemap',             label: 'Treemap',              category: 'Hierarchical' },
  { id: 'sunburst',            label: 'Sunburst',             category: 'Hierarchical' },

  { id: 'map',                 label: 'Map',                  category: 'Geographic', disabled: true },
  { id: 'choropleth',          label: 'Choropleth',           category: 'Geographic', disabled: true },
  { id: 'region-map',          label: 'Region Map',           category: 'Geographic', disabled: true },

  { id: 'gauge',                label: 'Gauge',                category: 'Operational' },
  { id: 'radial-bar',           label: 'Radial Bar',           category: 'Operational' },
  { id: 'funnel',                label: 'Funnel',               category: 'Operational' },
  { id: 'waterfall',            label: 'Waterfall',            category: 'Operational' },
  { id: 'calendar-heatmap',      label: 'Calendar Heatmap',     category: 'Operational' },
  { id: 'radar',                 label: 'Radar',                category: 'Operational' },
  { id: 'bullet',                label: 'Bullet Chart',         category: 'Operational', disabled: true },
  { id: 'timeline',              label: 'Timeline',             category: 'Operational', disabled: true },
  { id: 'gantt',                 label: 'Gantt',                category: 'Operational', disabled: true },
];

const CATEGORY_ORDER = ['Comparison', 'Trends', 'Distribution', 'Proportion', 'Relationships', 'Hierarchical', 'Geographic', 'Operational'];

component AnalyticsCard {
  props = {
    id: String,
    title: String,
    subtitle: String,
    data: Object,
    config: Object,
    onConfigChange: Function as (config: unknown) => void,
    availableTypes: Array as () => string[],
    loading: Boolean,
    lastRefreshed: String,
    onRefresh: Function as () => void,
    onExportDataset: Function as () => Array<Record<string, unknown>>,
    onDelete: Function as () => void,
    onLiveUpdate: Function as (point: unknown) => void,
    height: String,
  };

  state { let _menuOpen: boolean = false; }
  state { let _openSubmenu: string = ''; }
  state { let _fullscreen: boolean = false; }
  state { let _renaming: boolean = false; }
  state { let _renameValue: string = ''; }
  state { let _deleteConfirm: boolean = false; }
  state { let _localConfig: Record<string, unknown> | null = null; }

  _chart: any = null;
  _resizeHandler: any = null;
  chartId: string = `alp-analytics-card-${Math.random().toString(36).slice(2, 9)}`;

  _onDocClick = (e: MouseEvent) => {
    const target = e.target as HTMLElement;
    if (!target.closest?.(`#${this.chartId}-menu-wrap`)) {
      if (this._menuOpen || this._openSubmenu) {
        this._menuOpen = false;
        this._openSubmenu = '';
      }
    }
  };

  _onKeydown = (e: KeyboardEvent) => {
    if (e.key === 'Escape' && this._fullscreen) {
      this._fullscreen = false;
    }
  };

  async mounted() {
    document.addEventListener('click', this._onDocClick);
    window.addEventListener('keydown', this._onKeydown);
    if (!window.echarts) {
      try {
        await new Promise<void>((resolve, reject) => {
          const script = document.createElement('script');
          script.src = '/echarts.min.js';
          script.onload = () => resolve();
          script.onerror = () => reject(new Error('ECharts CDN failed'));
          document.head.appendChild(script);
        });
      } catch (_) { /* Chart body falls back to "unavailable" empty state */ }
    }
    this._resizeHandler = () => { try { this._chart?.resize(); } catch (_) {} };
    window.addEventListener('resize', this._resizeHandler);
    setTimeout(() => this._syncChart(), 60);
  }

  updated() {
    setTimeout(() => this._syncChart(), 30);
  }

  unmounted() {
    document.removeEventListener('click', this._onDocClick);
    window.removeEventListener('keydown', this._onKeydown);
    if (this._resizeHandler) window.removeEventListener('resize', this._resizeHandler);
    if (this._chart) { try { this._chart.dispose(); } catch (_) {} this._chart = null; }
  }

  // ---- config (controlled with uncontrolled fallback) ----

  _cfg(): Record<string, unknown> {
    const external = this.props.config;
    if (external) return { ...DEFAULT_CONFIG, ...external };
    if (this._localConfig) return { ...DEFAULT_CONFIG, ...this._localConfig };
    return { ...DEFAULT_CONFIG };
  }

  _emit(patch: Record<string, unknown> | null) {
    if (patch === null) {
      // Reset contract: null means "clear override, go back to defaults".
      if (this.props.onConfigChange) { this.props.onConfigChange(null); }
      else { this._localConfig = null; }
      return;
    }
    const next = { ...this._cfg(), ...patch };
    if (this.props.onConfigChange) { this.props.onConfigChange(next); }
    else { this._localConfig = next; }
  }

  // ---- chart lifecycle ----

  _css(prop: string): string {
    return getComputedStyle(document.documentElement).getPropertyValue(prop).trim();
  }

  _palette(cfg: Record<string, unknown>): string[] {
    return PALETTES[cfg.colorPalette as string] || PALETTES.default;
  }

  _hasEnoughData(cfg: Record<string, unknown>, data: any): boolean {
    if (!data) return false;
    const t = cfg.chartType as string;
    if (['pie', 'donut', 'nested-donut', 'polar-area', 'funnel'].includes(t)) return !!(data.series?.length || data.items?.length);
    if (['scatter', 'bubble'].includes(t)) return !!(data.points?.length);
    if (t === 'heatmap') return !!(data.matrix?.values?.length);
    if (t === 'gauge') return data.value != null;
    if (t === 'radar') return !!(data.indicators?.length && data.series?.length);
    if (['treemap', 'sunburst'].includes(t)) return !!(data.tree?.length);
    if (t === 'calendar-heatmap') return !!(data.calendar?.length);
    if (t === 'boxplot') return !!(data.boxes?.length);
    if (t === 'waterfall') return !!(data.steps?.length);
    if (t === 'histogram') return !!(data.values?.length || data.bins?.length);
    return !!(data.series?.length && (data.xAxis?.length || data.series.some((s: any) => s.data?.length)));
  }

  _syncChart() {
    const cfg = this._cfg();
    const echarts = (window as any).echarts;
    if (!echarts) return;
    const el = document.getElementById(this.chartId);
    if (!el) return;
    if (this.props.loading || !this._hasEnoughData(cfg, this.props.data)) {
      if (this._chart) { try { this._chart.dispose(); } catch (_) {} this._chart = null; }
      return;
    }
    if (!el.clientWidth || !el.clientHeight) {
      requestAnimationFrame(() => this._syncChart());
      return;
    }
    if (!this._chart) {
      this._chart = echarts.init(el, null, { renderer: 'canvas' });
    }
    try {
      const option = this._buildOption(cfg, this.props.data);
      this._chart.setOption(option, true);
      this._chart.resize();
    } catch (_) {
      try { this._chart.dispose(); } catch (_e) {}
      this._chart = null;
    }
  }

  // ---- option builder ----

  _axis(type: string, text: string, grid: string) {
    return {
      type,
      axisLabel: { color: text, fontSize: 10 },
      axisLine: { lineStyle: { color: grid } },
      splitLine: { lineStyle: { color: grid } },
    };
  }

  _barLikeOption(cfg: Record<string, unknown>, data: any, opts: { horizontal?: boolean; stacked?: boolean; percent?: boolean }) {
    const text = this._css('--color-text-secondary') || '#aaa';
    const grid = this._css('--color-bg-border') || '#2a2a2a';
    const palette = this._palette(cfg);
    const categories: string[] = data?.xAxis || [];
    let series = (data?.series || []).map((s: any) => ({ ...s }));

    if (opts.percent && series.length) {
      const sums: number[] = categories.map((_, i) => series.reduce((acc: number, s: any) => acc + (Number(s.data?.[i]) || 0), 0) || 1);
      series = series.map((s: any) => ({ ...s, data: (s.data || []).map((v: number, i: number) => (Number(v) / sums[i]) * 100) }));
    }

    const catAxis = this._axis('category', text, grid);
    (catAxis as any).data = categories;
    const valAxis = this._axis('value', text, grid);

    return {
      tooltip: { trigger: 'axis' },
      color: palette,
      grid: { left: 40, right: 16, top: 16, bottom: 32, containLabel: true },
      xAxis: opts.horizontal ? valAxis : catAxis,
      yAxis: opts.horizontal ? catAxis : valAxis,
      series: series.map((s: any) => ({
        type: 'bar',
        barMaxWidth: 40,
        stack: (opts.stacked || opts.percent) ? 'total' : undefined,
        itemStyle: { borderRadius: opts.stacked || opts.percent ? [0, 0, 0, 0] : [3, 3, 0, 0] },
        ...s,
      })),
    };
  }

  _lineLikeOption(cfg: Record<string, unknown>, data: any, opts: { area?: boolean; stacked?: boolean; step?: boolean }) {
    const text = this._css('--color-text-secondary') || '#aaa';
    const grid = this._css('--color-bg-border') || '#2a2a2a';
    const palette = this._palette(cfg);
    const catAxis = this._axis('category', text, grid);
    (catAxis as any).data = data?.xAxis || [];

    return {
      tooltip: { trigger: 'axis' },
      color: palette,
      grid: { left: 40, right: 16, top: 16, bottom: 32, containLabel: true },
      xAxis: catAxis,
      yAxis: this._axis('value', text, grid),
      series: (data?.series || []).map((s: any) => ({
        type: 'line',
        smooth: !opts.step,
        step: opts.step ? 'middle' : undefined,
        stack: opts.stacked ? 'total' : undefined,
        lineStyle: { width: 2 },
        areaStyle: opts.area ? { opacity: opts.stacked ? 0.5 : 0.35 } : undefined,
        ...s,
      })),
    };
  }

  _pieLikeOption(cfg: Record<string, unknown>, data: any, opts: { donut?: boolean; nested?: boolean }) {
    const text = this._css('--color-text-secondary') || '#aaa';
    const palette = this._palette(cfg);
    const items = data?.series || [];

    if (opts.nested) {
      return {
        tooltip: { trigger: 'item', formatter: '{b}: {c} ({d}%)' },
        color: palette,
        series: [
          { type: 'pie', radius: ['0%', '35%'], center: ['50%', '46%'], label: { show: false }, data: items[0]?.data || items[0] || [] },
          { type: 'pie', radius: ['45%', '70%'], center: ['50%', '46%'], label: { show: false }, data: items[1]?.data || items[1] || [] },
        ],
      };
    }

    const radius = opts.donut ? ['42%', '68%'] : '62%';
    return {
      tooltip: { trigger: 'item', formatter: '{b}: {c} ({d}%)' },
      legend: { bottom: 4, textStyle: { color: text, fontSize: 10 } },
      color: palette,
      series: items.map((s: any) => ({
        type: 'pie', radius, center: ['50%', '46%'],
        label: { show: false },
        emphasis: { label: { show: true, fontSize: 12 } }, ...s,
      })),
    };
  }

  _buildOption(cfg: Record<string, unknown>, data: any): Record<string, unknown> {
    const type = cfg.chartType as string;
    const text = this._css('--color-text-secondary') || '#aaa';
    const grid = this._css('--color-bg-border') || '#2a2a2a';
    const palette = this._palette(cfg);
    let option: Record<string, unknown> = {};

    if (type === 'bar' || type === 'grouped-bar') option = this._barLikeOption(cfg, data, {});
    else if (type === 'horizontal-bar') option = this._barLikeOption(cfg, data, { horizontal: true });
    else if (type === 'stacked-bar') option = this._barLikeOption(cfg, data, { stacked: true });
    else if (type === 'percent-stacked-bar') option = this._barLikeOption(cfg, data, { stacked: true, percent: true });
    else if (type === 'line') option = this._lineLikeOption(cfg, data, { area: true });
    else if (type === 'multi-line') option = this._lineLikeOption(cfg, data, {});
    else if (type === 'area') option = this._lineLikeOption(cfg, data, { area: true });
    else if (type === 'stacked-area') option = this._lineLikeOption(cfg, data, { area: true, stacked: true });
    else if (type === 'step-line') option = this._lineLikeOption(cfg, data, { step: true });
    else if (type === 'pie') option = this._pieLikeOption(cfg, data, {});
    else if (type === 'donut') option = this._pieLikeOption(cfg, data, { donut: true });
    else if (type === 'nested-donut') option = this._pieLikeOption(cfg, data, { nested: true });

    else if (type === 'histogram') {
      const bins = data?.bins || [];
      const catAxis = this._axis('category', text, grid);
      (catAxis as any).data = bins.map((b: any) => b.range);
      option = {
        tooltip: { trigger: 'axis' },
        color: palette,
        grid: { left: 40, right: 16, top: 16, bottom: 32, containLabel: true },
        xAxis: catAxis,
        yAxis: this._axis('value', text, grid),
        series: [{ type: 'bar', barMaxWidth: 40, data: bins.map((b: any) => b.count), itemStyle: { borderRadius: [3, 3, 0, 0] } }],
      };
    }

    else if (type === 'boxplot') {
      const boxes = data?.boxes || [];
      const catAxis = this._axis('category', text, grid);
      (catAxis as any).data = boxes.map((b: any) => b.name);
      option = {
        tooltip: { trigger: 'item' },
        color: palette,
        grid: { left: 40, right: 16, top: 16, bottom: 32, containLabel: true },
        xAxis: catAxis,
        yAxis: this._axis('value', text, grid),
        series: [{ type: 'boxplot', data: boxes.map((b: any) => b.values) }],
      };
    }

    else if (type === 'scatter' || type === 'bubble') {
      option = {
        tooltip: { trigger: 'item' },
        color: palette,
        grid: { left: 40, right: 16, top: 16, bottom: 32, containLabel: true },
        xAxis: this._axis('value', text, grid),
        yAxis: this._axis('value', text, grid),
        series: [{
          type: 'scatter',
          data: data?.points || [],
          symbolSize: type === 'bubble' ? (val: number[]) => Math.max(6, Math.sqrt(val[2] || 1) * 4) : 10,
        }],
      };
    }

    else if (type === 'heatmap') {
      const matrix = data?.matrix || { xCategories: [], yCategories: [], values: [] };
      const maxVal = Math.max(1, ...matrix.values.map((v: number[]) => v[2] || 0));
      option = {
        tooltip: { position: 'top' },
        grid: { left: 60, right: 16, top: 16, bottom: 60, containLabel: true },
        xAxis: { type: 'category', data: matrix.xCategories, splitArea: { show: true }, axisLabel: { color: text, fontSize: 10 } },
        yAxis: { type: 'category', data: matrix.yCategories, splitArea: { show: true }, axisLabel: { color: text, fontSize: 10 } },
        visualMap: { min: 0, max: maxVal, calculable: true, orient: 'horizontal', left: 'center', bottom: 0, textStyle: { color: text } },
        series: [{ type: 'heatmap', data: matrix.values, label: { show: !!cfg.showLabels } }],
      };
    }

    else if (type === 'gauge') {
      option = {
        series: [{
          type: 'gauge',
          max: data?.max ?? 100,
          data: [{ value: data?.value ?? 0, name: (cfg.customTitle as string) || '' }],
          detail: { color: text },
          axisLabel: { color: text, fontSize: 10 },
        }],
      };
    }

    else if (type === 'radar') {
      option = {
        tooltip: {},
        color: palette,
        radar: { indicator: data?.indicators || [], axisName: { color: text, fontSize: 10 } },
        series: [{ type: 'radar', data: (data?.series || []).map((s: any) => ({ name: s.name, value: s.values })) }],
      };
    }

    else if (type === 'funnel') {
      option = {
        tooltip: { trigger: 'item', formatter: '{b}: {c}' },
        color: palette,
        series: [{ type: 'funnel', left: 20, right: 20, label: { show: !!cfg.showLabels }, data: data?.items || [] }],
      };
    }

    else if (type === 'treemap' || type === 'sunburst') {
      option = {
        tooltip: { trigger: 'item' },
        color: palette,
        series: [{ type, data: data?.tree || [], label: { show: !!cfg.showLabels } }],
      };
    }

    else if (type === 'calendar-heatmap') {
      const cal = data?.calendar || [];
      const maxVal = Math.max(1, ...cal.map((d: any) => d.value || 0));
      option = {
        tooltip: {},
        calendar: {
          range: data?.range || [],
          cellSize: ['auto', 14],
          itemStyle: { borderWidth: 2, borderColor: this._css('--color-bg-surface') || '#111' },
          dayLabel: { color: text, fontSize: 10 },
          monthLabel: { color: text, fontSize: 10 },
          yearLabel: { show: false },
        },
        visualMap: { min: 0, max: maxVal, calculable: true, orient: 'horizontal', left: 'center', bottom: 0, textStyle: { color: text } },
        series: [{ type: 'heatmap', coordinateSystem: 'calendar', data: cal.map((d: any) => [d.date, d.value]) }],
      };
    }

    else if (type === 'polar-area' || type === 'radial-bar') {
      const categories: string[] = data?.xAxis || [];
      const values: number[] = data?.series?.[0]?.data || [];
      option = {
        tooltip: {},
        color: palette,
        polar: { radius: type === 'radial-bar' ? ['20%', '80%'] : ['10%', '75%'] },
        angleAxis: { max: Math.max(1, ...values), axisLabel: { color: text, fontSize: 10 } },
        radiusAxis: { type: 'category', data: categories, axisLabel: { color: text, fontSize: 10 } },
        series: [{
          type: 'bar',
          coordinateSystem: 'polar',
          data: values,
          roundCap: type === 'radial-bar',
        }],
      };
    }

    else if (type === 'waterfall') {
      const steps = data?.steps || [];
      let cum = 0;
      const bases: number[] = [];
      const deltas: number[] = [];
      steps.forEach((s: any) => {
        const v = Number(s.value) || 0;
        bases.push(v >= 0 ? cum : cum + v);
        deltas.push(Math.abs(v));
        cum += v;
      });
      const catAxis = this._axis('category', text, grid);
      (catAxis as any).data = steps.map((s: any) => s.name);
      option = {
        tooltip: { trigger: 'axis' },
        color: palette,
        grid: { left: 40, right: 16, top: 16, bottom: 32, containLabel: true },
        xAxis: catAxis,
        yAxis: this._axis('value', text, grid),
        series: [
          { name: 'Base', type: 'bar', stack: 'wf', itemStyle: { color: 'transparent' }, data: bases, silent: true, tooltip: { show: false } },
          { name: 'Value', type: 'bar', stack: 'wf', data: deltas, label: { show: !!cfg.showLabels, position: 'top' } },
        ],
      };
    }

    // Global display-option overlay
    if (!cfg.showTooltips) option.tooltip = { show: false };
    if (option.legend) (option.legend as any).show = !!cfg.showLegend;
    else if (cfg.showLegend && Array.isArray(option.series) && (option.series as any[]).length > 1) {
      option.legend = { show: true, bottom: 4, textStyle: { color: text, fontSize: 10 } };
    }
    if (Array.isArray(option.series)) {
      option.series = (option.series as any[]).map((s: any) => ({
        ...s,
        label: s.label ? { ...s.label, show: !!cfg.showLabels } : (cfg.showLabels ? { show: true } : s.label),
      }));
    }
    option.animation = !!cfg.animations;
    return option;
  }

  // ---- export ----

  _download(filename: string, content: string, mime: string) {
    const blob = new Blob([content], { type: mime });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
  }

  _exportImage(fmt: 'png' | 'svg') {
    if (!this._chart) return;
    try {
      const url = this._chart.getDataURL({ type: fmt, backgroundColor: this._css('--color-bg-surface') || '#fff' });
      const a = document.createElement('a');
      a.href = url;
      a.download = `${(this._cfg().customTitle as string) || this.props.title || 'chart'}.${fmt}`;
      document.body.appendChild(a);
      a.click();
      a.remove();
    } catch (_) { /* best-effort export */ }
  }

  _rowsFromData(): Array<Record<string, unknown>> {
    if (this.props.onExportDataset) { try { return this.props.onExportDataset() || []; } catch (_) { return []; } }
    const data = this.props.data;
    if (!data?.series) return [];
    const categories: string[] = data.xAxis || [];
    return categories.map((cat: string, i: number) => {
      const row: Record<string, unknown> = { category: cat };
      (data.series || []).forEach((s: any) => { row[s.name || 'value'] = s.data?.[i]; });
      return row;
    });
  }

  _exportCSV() {
    const rows = this._rowsFromData();
    if (!rows.length) return;
    const cols = Object.keys(rows[0]);
    const escape = (v: unknown) => `"${String(v ?? '').replace(/"/g, '""')}"`;
    const lines = [cols.join(','), ...rows.map((r) => cols.map((c) => escape(r[c])).join(','))];
    this._download(`${this.props.title || 'data'}.csv`, lines.join('\n'), 'text/csv');
  }

  // ---- a11y summary ----

  _summaryText(cfg: Record<string, unknown>, data: any): string {
    const type = cfg.chartType as string;
    if (!data) return `${type} chart, no data`;
    if (type === 'gauge') return `Gauge showing value ${data.value ?? '—'} of ${data.max ?? 100}`;
    const flatValues: number[] = (data.series || []).flatMap((s: any) => (s.data || []).filter((v: unknown) => typeof v === 'number'));
    if (!flatValues.length) return `${type} chart`;
    const min = Math.min(...flatValues);
    const max = Math.max(...flatValues);
    const n = (data.xAxis || data.series || []).length;
    return `${type} chart showing ${n} categories, values ranging from ${min} to ${max}`;
  }

  // ---- render ----

  _closeMenus() { this._menuOpen = false; this._openSubmenu = ''; }

  render() {
    const cfg = this._cfg();
    const height = this.props.height || '320px';
    const loading = !!this.props.loading;
    const hasData = this._hasEnoughData(cfg, this.props.data);
    const availableTypes = (this.props.availableTypes && this.props.availableTypes.length)
      ? CHART_TYPES.filter((t) => (this.props.availableTypes as string[]).includes(t.id))
      : CHART_TYPES;
    const displayTitle = (cfg.customTitle as string) || this.props.title;

    const fullscreenStyle = this._fullscreen
      ? 'position:fixed;inset:16px;z-index:1000;'
      : '';
    const backdropStyle = this._fullscreen
      ? 'position:fixed;inset:0;z-index:999;background:rgba(0,0,0,0.5);'
      : 'display:none;';

    return (
      <div class="alp-analytics-card-root">
        <div
          style={backdropStyle}
          onclick={() => { this._fullscreen = false; }}
        ></div>
        <div
          class="alp-analytics-card"
          role="figure"
          aria-label={displayTitle}
          style={fullscreenStyle}
        >
          <span class="alp-sr-only">{this._summaryText(cfg, this.props.data)}</span>

          <div class="alp-analytics-card-header">
            <div style="min-width:0;flex:1;">
              <input
                id={`${this.chartId}-title`}
                name={`${this.chartId}-title`}
                class="alp-analytics-card-title-input"
                style={this._renaming ? '' : 'display:none;'}
                value={this._renameValue}
                oninput={(e: any) => { this._renameValue = e.target.value; }}
                onkeydown={(e: KeyboardEvent) => {
                  if (e.key === 'Enter') { this._emit({ customTitle: this._renameValue || null }); this._renaming = false; }
                  if (e.key === 'Escape') { this._renaming = false; }
                }}
                onblur={() => { this._emit({ customTitle: this._renameValue || null }); this._renaming = false; }}
              />
              <div class="alp-analytics-card-title" style={this._renaming ? 'display:none;' : ''}>{displayTitle}</div>
              <div class="alp-analytics-card-subtitle" style={this.props.subtitle ? '' : 'display:none;'}>{this.props.subtitle}</div>
            </div>

            <div class="alp-analytics-card-header-actions">
              <span class="alp-analytics-card-refreshed" style={this.props.lastRefreshed ? '' : 'display:none;'}>{this.props.lastRefreshed}</span>
              <span class="alp-spinner alp-spinner--sm alp-spinner--muted" style={loading ? '' : 'display:none;'}>
                <span class="alp-spinner-ring"></span>
              </span>

              <div id={`${this.chartId}-menu-wrap`} style="position:relative;display:flex;">
                <button
                  class={`alp-dt-options-btn ${this._menuOpen ? 'alp-dt-options-btn--active' : ''}`}
                  style="opacity:1;"
                  aria-haspopup="menu"
                  aria-expanded={this._menuOpen}
                  onclick={() => { this._menuOpen = !this._menuOpen; this._openSubmenu = ''; }}
                  title="Widget options"
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14">
                    <circle cx="12" cy="5" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="12" cy="19" r="1"/>
                  </svg>
                </button>

                {/* Top-level menu */}
                <div class="alp-menu" style={this._menuOpen ? '' : 'display:none;'}>
                  <button class="alp-menu-item" onclick={() => { this._openSubmenu = this._openSubmenu === 'chartType' ? '' : 'chartType'; }}>
                    <span>Chart Type</span>
                    <span class="alp-menu-arrow">›</span>
                  </button>
                  <button class="alp-menu-item" onclick={() => { this._openSubmenu = this._openSubmenu === 'display' ? '' : 'display'; }}>
                    <span>Display</span>
                    <span class="alp-menu-arrow">›</span>
                  </button>
                  <div class="alp-menu-divider"></div>
                  <button class="alp-menu-item" disabled={!this.props.onRefresh} onclick={() => { this.props.onRefresh?.(); this._closeMenus(); }}>
                    <span>Refresh Now</span>
                  </button>
                  <button class="alp-menu-item" onclick={() => { this._openSubmenu = this._openSubmenu === 'export' ? '' : 'export'; }}>
                    <span>Export</span>
                    <span class="alp-menu-arrow">›</span>
                  </button>
                  <button class="alp-menu-item" onclick={() => { this._fullscreen = !this._fullscreen; this._closeMenus(); }}>
                    <span>{this._fullscreen ? 'Exit Fullscreen' : 'Fullscreen'}</span>
                  </button>
                  <div class="alp-menu-divider"></div>
                  <button class="alp-menu-item" onclick={() => {
                    this._renameValue = displayTitle || '';
                    this._renaming = true;
                    this._closeMenus();
                  }}>
                    <span>Rename Widget</span>
                  </button>
                  <button class="alp-menu-item" onclick={() => { this._emit(null); this._closeMenus(); }}>
                    <span>Reset Widget</span>
                  </button>
                  <div class="alp-menu-divider" style={this.props.onDelete ? '' : 'display:none;'}></div>
                  <button
                    class="alp-menu-item"
                    style={this.props.onDelete ? '' : 'display:none;'}
                    onclick={(e: MouseEvent) => { e.stopPropagation(); this._deleteConfirm = !this._deleteConfirm; }}
                  >
                    <span style="color:var(--color-danger,#ef4444);">{this._deleteConfirm ? 'Click again to confirm' : 'Delete Widget'}</span>
                  </button>
                  <button
                    class="alp-menu-item"
                    style={(this._deleteConfirm && this.props.onDelete) ? 'color:var(--color-danger,#ef4444);font-weight:700;' : 'display:none;'}
                    onclick={() => { this.props.onDelete?.(); this._deleteConfirm = false; this._closeMenus(); }}
                  >
                    Confirm Delete
                  </button>
                </div>

                {/* Chart type submenu */}
                <div class="alp-menu alp-menu--sub" style={this._openSubmenu === 'chartType' ? '' : 'display:none;'} onclick={(e: MouseEvent) => e.stopPropagation()}>
                  {CATEGORY_ORDER.map((cat) => {
                    const items = availableTypes.filter((t) => t.category === cat);
                    if (!items.length) return null;
                    return (
                      <div key={cat}>
                        <div class="alp-menu-section-label">{cat}</div>
                        {items.map((t) => (
                          <button
                            key={t.id}
                            class={`alp-menu-item ${cfg.chartType === t.id ? 'alp-menu-item--active' : ''}`}
                            disabled={!!t.disabled}
                            onclick={() => { if (!t.disabled) { this._emit({ chartType: t.id }); this._closeMenus(); } }}
                          >
                            <span>{t.label}</span>
                            <span class="alp-menu-badge" style={t.disabled ? '' : 'display:none;'}>Soon</span>
                          </button>
                        ))}
                      </div>
                    );
                  })}
                </div>

                {/* Display submenu */}
                <div class="alp-menu alp-menu--sub" style={this._openSubmenu === 'display' ? '' : 'display:none;'} onclick={(e: MouseEvent) => e.stopPropagation()}>
                  <button class={`alp-menu-item ${cfg.showLegend ? 'alp-menu-item--active' : ''}`} onclick={() => this._emit({ showLegend: !cfg.showLegend })}>Toggle Legend</button>
                  <button class={`alp-menu-item ${cfg.showLabels ? 'alp-menu-item--active' : ''}`} onclick={() => this._emit({ showLabels: !cfg.showLabels })}>Toggle Labels</button>
                  <button class={`alp-menu-item ${cfg.showTooltips ? 'alp-menu-item--active' : ''}`} onclick={() => this._emit({ showTooltips: !cfg.showTooltips })}>Toggle Tooltips</button>
                  <button class={`alp-menu-item ${cfg.animations ? 'alp-menu-item--active' : ''}`} onclick={() => this._emit({ animations: !cfg.animations })}>Toggle Animations</button>
                  <div class="alp-menu-divider"></div>
                  <button class="alp-menu-item" onclick={() => { this._openSubmenu = 'palette'; }}>
                    <span>Colour Palette</span>
                    <span class="alp-menu-arrow">›</span>
                  </button>
                </div>

                {/* Palette submenu */}
                <div class="alp-menu alp-menu--sub" style={this._openSubmenu === 'palette' ? '' : 'display:none;'} onclick={(e: MouseEvent) => e.stopPropagation()}>
                  {Object.keys(PALETTES).map((name) => (
                    <button key={name} class={`alp-menu-item ${cfg.colorPalette === name ? 'alp-menu-item--active' : ''}`} onclick={() => { this._emit({ colorPalette: name }); this._closeMenus(); }}>
                      <span style={`display:inline-block;width:10px;height:10px;border-radius:50%;background:${PALETTES[name][0]};margin-right:4px;`}></span>
                      <span style="text-transform:capitalize;">{name}</span>
                    </button>
                  ))}
                </div>

                {/* Export submenu */}
                <div class="alp-menu alp-menu--sub" style={this._openSubmenu === 'export' ? '' : 'display:none;'} onclick={(e: MouseEvent) => e.stopPropagation()}>
                  <button class="alp-menu-item" onclick={() => { this._exportImage('png'); this._closeMenus(); }}>Export PNG</button>
                  <button class="alp-menu-item" onclick={() => { this._exportImage('svg'); this._closeMenus(); }}>Export SVG</button>
                  <button class="alp-menu-item" onclick={() => { this._exportCSV(); this._closeMenus(); }}>Export CSV</button>
                </div>
              </div>
            </div>
          </div>

          <div class="alp-analytics-card-body" style={`height:${height};`}>
            <div style={loading ? '' : 'display:none;'}>
              <div class="alp-kpi-skel alp-kpi-skel--sm" style="margin:12px;"></div>
              <div class="alp-card-skel-chart"></div>
            </div>
            <div class="alp-analytics-card-empty" style={(!loading && !hasData) ? '' : 'display:none;'}>
              <div>No data for this chart</div>
              <div style="font-size:11px;margin-top:4px;opacity:0.7;">Try a different chart type or check your filters</div>
            </div>
            <div id={this.chartId} class="alp-analytics-chart-canvas" style={(!loading && hasData) ? 'width:100%;height:100%;' : 'display:none;'}></div>
          </div>
        </div>
      </div>
    );
  }
}
