import { SwissComponent } from '@swissjs/core';
// FRONT-SHELL-004: script load, DOM-disappearance watchdog and instance
// staleness/retry logic now live in chart-host.ui, shared with AnalyticsCard.uix
// -- this component previously had none of the watchdog/retry resilience
// AnalyticsCard already carried, despite painting the same kind of
// vdom-invisible <canvas>.
import { ensureEchartsLoaded, startChartWatchdog, syncChartInstance, disposeChart } from './chart-host.ui';

component Chart {
  props = {
    data: Object,
    height: String,
    theme: String,
    style: String,
  };

  state { let chartId: string = `alp-chart-${Math.random().toString(36).slice(2, 9)}`; }
  state { let failed: boolean = false; }

  _chart: any = null;
  _resizeHandler: any = null;
  _watchdog: any = null;

  async mounted() {
    try {
      await ensureEchartsLoaded();
    } catch (_) {
      this.failed = true;
      return;
    }
    this.initChart();
    this._resizeHandler = () => { try { this._chart?.resize(); } catch (_) {} };
    window.addEventListener('resize', this._resizeHandler);
    this._watchdog = startChartWatchdog(this.chartId, () => !this.failed && !!this.props.data, () => this.initChart());
  }

  initChart() {
    const theme = this.props.theme || document.documentElement.getAttribute('data-theme') || 'dark';
    this._chart = syncChartInstance(this.chartId, (instance) => {
      if (this.props.data) instance.setOption(this.props.data);
    }, { theme });
  }

  unmounted() {
    if (this._resizeHandler) window.removeEventListener('resize', this._resizeHandler);
    if (this._watchdog) this._watchdog();
    disposeChart(this.chartId);
    this._chart = null;
  }

  async updated() {
    if (this._chart && this.props.data) {
      this._chart.setOption(this.props.data, { notMerge: false });
    } else if (!this._chart && this.props.data && !this.failed) {
      this.initChart();
    }
  }

  render() {
    const h = this.props.height || '300px';
    const s = this.props.style || '';

    if (this.failed) {
      return (
        <div style={`width:100%;height:${h};display:flex;align-items:center;justify-content:center;color:var(--color-text-muted);font-size:var(--font-size-xs);${s}`}>
          Chart unavailable
        </div>
      );
    }

    return (
      <div
        id={this.chartId}
        style={`width:100%;height:${h};${s}`}
      ></div>
    );
  }
}
