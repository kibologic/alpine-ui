import { SwissComponent } from '@swissjs/core';

component Chart {
  props = {
    type: String,      // 'bar' | 'line' | 'pie' | 'area'
    data: Object,      // ECharts option object
    height: { type: String, default: '300px' },
    theme: String,     // 'dark' | 'light'
  };

  state { let chart: any = null; }

  async mounted() {
    // Load ECharts from CDN if not already loaded
    if (!window.echarts) {
      await new Promise((resolve, reject) => {
        const script = document.createElement('script');
        script.src = 'https://cdn.jsdelivr.net/npm/echarts@5/dist/echarts.min.js';
        script.onload = resolve;
        script.onerror = reject;
        document.head.appendChild(script);
      });
    }
    this.initChart();
  }

  initChart() {
    const el = this.refs.chartContainer;
    if (!el) return;

    // Detect theme from data-theme if not provided
    const theme = this.theme || document.documentElement.getAttribute('data-theme') || 'light';
    
    this.chart = window.echarts.init(el, theme);
    if (this.data) {
      this.chart.setOption(this.data);
    }

    // Handle resize
    window.addEventListener('resize', () => this.chart?.resize());
  }

  unmounted() {
    if (this.chart) {
      this.chart.dispose();
      this.chart = null;
    }
  }

  async updated() {
    if (this.chart && this.data) {
      this.chart.setOption(this.data);
    }
  }

  render() {
    return (
      <div 
        ref="chartContainer" 
        style={{ width: '100%', height: this.height }}
      ></div>
    );
  }
}
