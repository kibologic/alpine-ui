import { SwissComponent } from '@kibologic/core';

component Chart {
  props = {
    data: Object,
    height: String,
    theme: String,
    style: String,
  };

  state { let chartId: string = `alp-chart-${Math.random().toString(36).slice(2, 9)}`; }
  state { let failed: boolean = false; }

  _chart: any = null;
  _resizeHandler: any = null;

  async mounted() {
    if (!window.echarts) {
      try {
        await new Promise<void>((resolve, reject) => {
          const script = document.createElement('script');
          script.src = 'https://cdn.jsdelivr.net/npm/echarts@5/dist/echarts.min.js';
          script.onload = () => resolve();
          script.onerror = () => reject(new Error('ECharts CDN failed'));
          document.head.appendChild(script);
        });
      } catch (_) {
        this.failed = true;
        return;
      }
    }
    this.initChart();
  }

  initChart() {
    if (!window.echarts) return;
    const el = document.getElementById(this.chartId);
    if (!el) return;
    const theme = this.props.theme || document.documentElement.getAttribute('data-theme') || 'dark';
    this._chart = window.echarts.init(el, theme);
    if (this.props.data) this._chart.setOption(this.props.data);
    this._resizeHandler = () => this._chart?.resize();
    window.addEventListener('resize', this._resizeHandler);
  }

  unmounted() {
    if (this._resizeHandler) window.removeEventListener('resize', this._resizeHandler);
    if (this._chart) { this._chart.dispose(); this._chart = null; }
  }

  async updated() {
    if (this._chart && this.props.data) {
      this._chart.setOption(this.props.data, { notMerge: false });
    } else if (!this._chart && this.props.data && !this.failed && window.echarts) {
      this.initChart();
    }
  }

  render() {
    const h = this.props.height || '300px';
    const s = this.props.style || '';

    if (this.failed) {
      return (
        <div style={`width:100%;height:${h};display:flex;align-items:center;justify-content:center;color:var(--color-text-muted);font-size:var(--font-size-xs);${s}`}>
          Chart unavailable
        </div>
      );
    }

    return (
      <div
        id={this.chartId}
        style={`width:100%;height:${h};${s}`}
      ></div>
    );
  }
}
