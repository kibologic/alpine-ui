import { SwissComponent } from '@swissjs/core';
import { Modal } from '../feedback/Modal.uix';
import { DataTable } from './DataTable.uix';

component DataImport {
  props = {
    columns: Array as () => Array<{ key: string; label: string; required?: boolean; type?: string }>,
    onImport: Function as (validRows: any[]) => void,
    entityName: String,
  };

  state { let isModalOpen: boolean = false; }
  state { let parsedData: any[] = []; }
  state { let validationErrors: number = 0; }
  state { let mapping: Record<string, string> = {}; }
  state { let isValidated: boolean = false; }

  open() {
    this.isModalOpen = true;
    this.parsedData = [];
    this.validationErrors = 0;
    this.mapping = {};
    this.isValidated = false;
    this.scheduleUpdate?.();
  }

  close() {
    this.isModalOpen = false;
    this.scheduleUpdate?.();
  }

  async handleFileUpload(e: Event) {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;

    try {
      if (!window.XLSX) {
        const script = document.createElement('script');
        script.src = 'https://cdn.sheetjs.com/xlsx-latest/package/dist/xlsx.full.min.js';
        document.head.appendChild(script);
        await new Promise((resolve) => script.onload = resolve);
      }

      const reader = new FileReader();
      reader.onload = (e) => {
        const data = new Uint8Array(e.target?.result as ArrayBuffer);
        const workbook = window.XLSX.read(data, { type: 'array' });
        const firstSheetName = workbook.SheetNames[0];
        const worksheet = workbook.Sheets[firstSheetName];
        let json = window.XLSX.utils.sheet_to_json(worksheet);
        
        // Auto-map columns if labels match
        const headers = Object.keys(json[0] || {});
        let newMapping: Record<string, string> = {};
        const propsColumns = Array.isArray(this.props.columns) ? this.props.columns : [];
        propsColumns.forEach(col => {
          const match = headers.find(h => h.toLowerCase() === col.label.toLowerCase() || h.toLowerCase() === col.key.toLowerCase());
          if (match) newMapping[col.key] = match;
        });

        this.mapping = newMapping;
        this.parsedData = Object.freeze(json);
        this.validateData();
      };
      reader.readAsArrayBuffer(file);
    } catch (err) {
      console.error('Import failed', err);
      alert('Failed to read file.');
    }
  }

  validateData() {
    let errors = 0;
    const validated = [...this.parsedData];
    const propsColumns = Array.isArray(this.props.columns) ? this.props.columns : [];

    for (let i = 0; i < validated.length; i++) {
        const row = validated[i];
        let rowHasError = false;
        const newRow: Record<string, any> = { ...row, _errors: {} };

        propsColumns.forEach(col => {
            const mappedHeader = this.mapping[col.key];
            const val = mappedHeader ? row[mappedHeader] : undefined;

            if (col.required && (val === undefined || val === null || val === '')) {
                newRow._errors[col.key] = 'Required';
                rowHasError = true;
            } else if (val !== undefined && val !== null && val !== '') {
                if (col.type === 'number' && isNaN(Number(val))) {
                    newRow._errors[col.key] = 'Invalid Number';
                    rowHasError = true;
                } else if (col.type === 'currency' && isNaN(Number(val.toString().replace(/,/g, '')))) {
                    newRow._errors[col.key] = 'Invalid Currency';
                    rowHasError = true;
                }
            }
        });

        if (rowHasError) errors++;
        validated[i] = newRow;
    }

    this.parsedData = validated;
    this.validationErrors = errors;
    this.isValidated = true;
    this.scheduleUpdate?.();
  }

  confirmImport() {
    if (this.validationErrors > 0) return;
    
    // Map to normalized structure
    const propsColumns = Array.isArray(this.props.columns) ? this.props.columns : [];
    const normalizedData = this.parsedData.map(row => {
        const out: Record<string, any> = {};
        propsColumns.forEach(c => {
            const val = this.mapping[c.key] ? row[this.mapping[c.key]] : undefined;
            if (c.type === 'number') out[c.key] = val ? Number(val) : 0;
            else if (c.type === 'currency') out[c.key] = val ? Number(val.toString().replace(/,/g, '')) : 0;
            else out[c.key] = val !== undefined ? String(val) : '';
        });
        return out;
    });

    if (this.props.onImport) this.props.onImport(normalizedData);
    this.close();
  }

  render() {
    const entity = this.props.entityName || 'data';
    
    return (
      <div style="display: inline-block;">
        <button type="button" class="aui-btn" onclick={() => this.open()}>
          Import {entity}
        </button>

        <Modal
          open={this.isModalOpen}
          title={`Import ${entity}`}
          size="lg"
          onclose={() => this.close()}
          renderBody={() => (
            <div>
              {this.parsedData.length === 0 ? (
                <div style="border: 2px dashed var(--dusty-denim); padding: 3rem; text-align: center; border-radius: 8px; margin-bottom: 1rem; background: var(--alabaster-grey);">
                  <div style="font-size: 2rem; margin-bottom: 1rem; color: var(--dusk-blue);">📄</div>
                  <div style="margin-bottom: 1rem; color: var(--prussian-blue); font-weight: 500;">
                    Drop .xlsx or .csv here or click to browse
                  </div>
                  <input type="file" accept=".xlsx, .csv" onchange={(e: Event) => this.handleFileUpload(e)} style="display: block; margin: 0 auto; color: var(--ink-black);" />
                </div>
              ) : (
                <div>
                   <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                      <div style="font-weight: 500; color: var(--ink-black);">
                          Preview ({this.parsedData.length} rows)
                      </div>
                      {this.isValidated ? (
                          <div style={`color: ${this.validationErrors > 0 ? '#d32f2f' : 'var(--dusk-blue)'}; font-weight: bold; padding: 0.5rem 1rem; background: var(--alabaster-grey); border-radius: 4px; border: 1px solid ${this.validationErrors > 0 ? '#d32f2f' : 'var(--dusk-blue)'};`}>
                              {this.validationErrors} errors found
                          </div>
                      ) : null}
                   </div>
                   
                   <div style="overflow-x: auto; max-height: 400px; border: 1px solid var(--dusty-denim); border-radius: 4px;">
                      <table class="aui-table">
                          <thead style="position: sticky; top: 0; z-index: 10;">
                              <tr>
                                  {(Array.isArray(this.props.columns) ? this.props.columns : []).map(col => (
                                      <th style="background: var(--prussian-blue);">
                                          {col.label} {col.required ? <span style="color: red;">*</span> : ''}
                                      </th>
                                  ))}
                              </tr>
                          </thead>
                          <tbody>
                              {this.parsedData.slice(0, 10).map((row, idx) => (
                                  <tr>
                                      {(Array.isArray(this.props.columns) ? this.props.columns : []).map(col => {
                                          const mappedHeader = this.mapping[col.key];
                                          const val = mappedHeader ? row[mappedHeader] : '';
                                          const error = row._errors ? row._errors[col.key] : null;
                                          return (
                                              <td style={error ? 'background-color: rgba(211, 47, 47, 0.1); border: 1px solid #d32f2f;' : ''}>
                                                  {val}
                                                  {error ? <div style="font-size: 0.75rem; color: #d32f2f; font-weight: bold;">{error}</div> : null}
                                              </td>
                                          );
                                      })}
                                  </tr>
                              ))}
                          </tbody>
                      </table>
                   </div>
                   {this.parsedData.length > 10 ? <div style="text-align: center; color: var(--dusty-denim); padding: 0.5rem; font-size: 0.875rem;">Showing first 10 rows</div> : null}
                </div>
              )}
            </div>
          )}
          renderFooter={() => (
             <div>
                <button 
                  class="aui-btn aui-btn--outline" 
                  onclick={() => this.close()}
                  style="margin-right: 1rem; background: transparent; color: var(--ink-black); border: 1px solid var(--dusty-denim);"
                >Cancel</button>
                <button 
                  class="aui-btn" 
                  disabled={!this.isValidated || this.validationErrors > 0 || this.parsedData.length === 0}
                  onclick={() => this.confirmImport()}
                  style={(!this.isValidated || this.validationErrors > 0 || this.parsedData.length === 0) ? 'opacity: 0.5; cursor: not-allowed;' : ''}
                >Confirm Import</button>
             </div>
          )}
        />
      </div>
    );
  }
}
