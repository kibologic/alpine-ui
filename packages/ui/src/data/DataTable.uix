import { SwissComponent } from '@swissjs/core';
import type { DataTableColumn } from '@alpine/erp-core';

component DataTable {
  props = {
    id: String,
    columns: Array as () => DataTableColumn[],
    rows: Array as () => Array<Record<string, any>>,
    loading: Boolean,
    pageSize: Number as () => number,
    filename: String,
    emptyTitle: String,
    emptyDescription: String,
    onRowClick: Function as (row: Record<string, unknown>) => void,
    onSelectionChange: Function as (rows: Record<string, unknown>[]) => void,
  };

  state { let query: string = ''; }
  state { let showFilters: boolean = false; }
  state { let columnFilters: Record<string, string> = {}; }
  state { let filterCols: Record<string, boolean> = {}; }
  state { let showFilterMenu: boolean = false; }
  state { let debounceTimer: ReturnType<typeof setTimeout> | null = null; }
  state { let sortKey: string = ''; }
  state { let sortDir: string = 'asc'; }
  state { let currentPage: number = 1; }
  state { let rowsPerPage: number = 20; }
  state { let rowsPerPageOptions: number[] = [10, 20, 50, 100]; }
  state { let selectedIds: Record<string, boolean> = {}; }
  state { let hiddenCols: Record<string, boolean> = {}; }
  state { let showColumnMenu: boolean = false; }
  state { let showActions: boolean = false; }
  state { let resizingKey: string = ''; }
  state { let resizeStartX: number = 0; }
  state { let resizeStartW: number = 0; }
  state { let colWidths: Record<string, string> = {}; }

  mounted() {
    this.rowsPerPage = this.props.pageSize || 20;
    this.loadPersistedState();
    document.addEventListener('click', (e: MouseEvent) => {
      if (!e.target.closest('.alp-dt-actions-wrap')) {
        if (this.showActions || this.showColumnMenu || this.showFilterMenu) {
          this.showActions = false;
          this.showColumnMenu = false;
          this.showFilterMenu = false;
        }
      }
    });
  }

  getStorageKey() {
    let uid = '0000';
    try {
      const raw = localStorage.getItem('alpine-user');
      if (raw) {
        const u = typeof raw === 'string' ? JSON.parse(raw) : raw;
        uid = (u as Record<string, string>)?.id || '0000';
      }
    } catch (_) {}
    return `alp-dt-v5-${uid}-${this.props.id || 'default'}`;
  }

  saveState(extraData: Record<string, unknown>) {
    try {
      const existing = JSON.parse(localStorage.getItem(this.getStorageKey()) || '{}');
      localStorage.setItem(this.getStorageKey(), JSON.stringify({ ...existing, ...extraData }));
    } catch (_) {}
  }

  loadPersistedState() {
    try {
      const saved = localStorage.getItem(this.getStorageKey());
      if (!saved) return;
      const s = JSON.parse(saved);
      if (s.sortKey)    this.sortKey    = s.sortKey;
      if (s.sortDir)    this.sortDir    = s.sortDir;
      if (s.rowsPerPage) this.rowsPerPage = s.rowsPerPage;
      if (s.hiddenCols) this.hiddenCols = s.hiddenCols;
      if (s.colWidths)  this.colWidths  = s.colWidths;
    } catch (_) {}
  }

  handleSearch(val: string) {
    this.query = val;
    this.currentPage = 1;
  }

  handleColumnFilter(key: string, val: string) {
    this.columnFilters = { ...this.columnFilters, [key]: val };
    this.currentPage = 1;
  }

  handleSort(key: string) {
    if (this.sortKey === key) {
      this.sortDir = this.sortDir === 'asc' ? 'desc' : 'asc';
    } else {
      this.sortKey = key;
      this.sortDir = 'asc';
    }
    this.currentPage = 1;
    this.saveState({ sortKey: this.sortKey, sortDir: this.sortDir });
  }

  getProcessedRows() {
    const rows = Array.isArray(this.props.rows) ? this.props.rows : [];
    const q = (this.query || '').toLowerCase().trim();
    let data = rows.filter(row => {
      if (q && !Object.values(row).some(v => v != null && String(v).toLowerCase().includes(q))) return false;
      const filters = this.columnFilters;
      for (const key in filters) {
        const fv = (filters[key] || '').toLowerCase().trim();
        if (!fv) continue;
        const rv = row[key];
        if (rv == null || !String(rv).toLowerCase().includes(fv)) return false;
      }
      return true;
    });
    if (this.sortKey) {
      const dir = this.sortDir === 'asc' ? 1 : -1;
      data = data.slice().sort((a, b) => {
        const av = a[this.sortKey] ?? ''; const bv = b[this.sortKey] ?? '';
        const na = Number(av); const nb = Number(bv);
        if (!isNaN(na) && !isNaN(nb)) return dir * (na - nb);
        const da = Date.parse(av); const db = Date.parse(bv);
        if (!isNaN(da) && !isNaN(db)) return dir * (da - db);
        return dir * String(av).localeCompare(String(bv), undefined, { numeric: true });
      });
    }
    return data;
  }

  isSelected(row: Record<string, unknown>) {
    const id = row.id || row._id;
    return id != null && !!this.selectedIds[String(id)];
  }

  toggleRow(row: Record<string, unknown>) {
    const id = String(row.id || row._id);
    const next = { ...this.selectedIds };
    if (next[id]) { delete next[id]; } else { next[id] = true; }
    this.selectedIds = next;
    this._emitSelectionChange();
  }

  toggleAll(visibleRows: Record<string, unknown>[]) {
    const allSelected = visibleRows.every(r => this.isSelected(r));
    const next = { ...this.selectedIds };
    if (allSelected) {
      visibleRows.forEach(r => { const id = String(r.id || r._id); delete next[id]; });
    } else {
      visibleRows.forEach(r => { const id = String(r.id || r._id); next[id] = true; });
    }
    this.selectedIds = next;
    this._emitSelectionChange();
  }

  // `onSelectionChange` was declared as a prop but never actually called
  // anywhere in this file -- any consumer passing it (e.g. a bulk-action
  // bar) silently never received a selection. Emits the full selected row
  // objects (not just ids), matching the prop's own declared type.
  _emitSelectionChange() {
    if (typeof this.props.onSelectionChange !== 'function') return;
    const selected = (this.props.rows || []).filter((r: Record<string, unknown>) => this.isSelected(r));
    this.props.onSelectionChange(selected);
  }

  toggleCol(key: string) {
    const next = { ...this.hiddenCols };
    if (next[key]) { delete next[key]; } else { next[key] = true; }
    this.hiddenCols = next;
    this.saveState({ hiddenCols: next });
  }

  startResize(e: PointerEvent, key: string) {
    e.preventDefault(); e.stopPropagation();
    this.resizingKey = key;
    this.resizeStartX = e.pageX;
    const th = (e.target as HTMLElement).closest('th') as HTMLElement;
    this.resizeStartW = th ? th.offsetWidth : 120;
    const onMove = (me: PointerEvent) => {
      if (!this.resizingKey) return;
      const newW = Math.max(60, this.resizeStartW + (me.pageX - this.resizeStartX));
      this.colWidths = { ...this.colWidths, [this.resizingKey]: `${newW}px` };
    };
    const onUp = () => {
      this.saveState({ colWidths: this.colWidths });
      this.resizingKey = '';
      window.removeEventListener('pointermove', onMove);
      window.removeEventListener('pointerup', onUp);
    };
    // Pointer Events unify mouse/touch/pen so column resize works on tablets.
    window.addEventListener('pointermove', onMove);
    window.addEventListener('pointerup', onUp);
  }

  handleExport() {
    const rows = this.props.rows || [];
    const cols = (this.props.columns || []).filter(c => !this.hiddenCols[c.key]);
    const header = cols.map(c => `"${c.label}"`).join(',');
    const body = rows.map(r => cols.map(c => {
      const v = r[c.key]; return JSON.stringify(v != null ? String(v) : '');
    }).join(',')).join('\n');
    const csv = header + '\n' + body;
    const blob = new Blob([csv], { type: 'text/csv' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = (this.props.filename || 'export') + '.csv'; a.click();
    URL.revokeObjectURL(url);
  }

  render() {
    const allCols  = Array.isArray(this.props.columns) ? this.props.columns : [];
    const visCols  = allCols.filter(c => !this.hiddenCols[c.key]);
    const isLoading = !!this.props.loading;

    const processed   = this.getProcessedRows();
    const totalRows   = processed.length;
    const totalPages  = Math.max(1, Math.ceil(totalRows / this.rowsPerPage));
    const safePage    = Math.min(this.currentPage, totalPages);
    const start       = (safePage - 1) * this.rowsPerPage;
    const pageRows    = processed.slice(start, start + this.rowsPerPage);
    const allOnPageSelected = pageRows.length > 0 && pageRows.every(r => this.isSelected(r));
    const selectedCount = Object.keys(this.selectedIds).length;
    const colCount   = visCols.length + 1; // +1 for checkbox

    return (
      <div class="alp-dt">

        {/* ── Toolbar: pagination left, search right ── */}
        <div class="alp-dt-toolbar">
          <div class="alp-dt-toolbar-left">
            {selectedCount > 0 ? (
              <span class="alp-dt-selection-badge">{selectedCount} selected</span>
            ) : null}
            {!isLoading ? (
              <div class="alp-dt-pg-compact">
                <button class="alp-dt-pg-nav" disabled={safePage <= 1}
                  onclick={() => { this.currentPage = 1; }} title="First page">«</button>
                <button class="alp-dt-pg-nav" disabled={safePage <= 1}
                  onclick={() => { this.currentPage = safePage - 1; }} title="Previous page">‹</button>
                <span class="alp-dt-pg-label">
                  {totalRows > 0 ? `${safePage} / ${totalPages}` : '—'}
                </span>
                <button class="alp-dt-pg-nav" disabled={safePage >= totalPages}
                  onclick={() => { this.currentPage = safePage + 1; }} title="Next page">›</button>
                <button class="alp-dt-pg-nav" disabled={safePage >= totalPages}
                  onclick={() => { this.currentPage = totalPages; }} title="Last page">»</button>
                <div class="alp-dt-pg-divider"></div>
                <select class="alp-dt-select-sm" value={this.rowsPerPage}
                  onchange={(e: Event) => { this.rowsPerPage = Number((e.target as HTMLSelectElement).value); this.currentPage = 1; this.saveState({ rowsPerPage: this.rowsPerPage }); }}>
                  {this.rowsPerPageOptions.map(opt => <option value={opt}>{opt}</option>)}
                </select>
                <span class="alp-dt-pg-sep">/ page</span>
                {totalRows > 0 ? (
                  <span class="alp-dt-pg-count">
                    {start + 1}–{Math.min(start + this.rowsPerPage, totalRows)} of {totalRows}
                  </span>
                ) : (
                  <span class="alp-dt-pg-count">0 results</span>
                )}
              </div>
            ) : null}
          </div>
          <div class="alp-dt-toolbar-right">
            <div class="alp-dt-search-wrap">
              <svg class="alp-dt-search-icon" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
              </svg>
              <input
                type="search"
                class="alp-dt-search"
                placeholder="Search…"
                oninput={(e: Event) => this.handleSearch((e.target as HTMLInputElement).value)}
              />
            </div>
          </div>
        </div>

        {/* ── Table ── */}
        <div class="alp-dt-table-wrap">
          <table class="alp-dt-table">
            <thead>
              <tr class="alp-dt-head-row">
                <th class="alp-dt-th alp-dt-th--check">
                  <input type="checkbox" class="alp-dt-checkbox" checked={allOnPageSelected}
                    onchange={() => this.toggleAll(pageRows)} />
                </th>

                {visCols.map(col => {
                  const colW = this.colWidths[col.key] || col.width || '';
                  const isSorted = this.sortKey === col.key;
                  return (
                    <th class={`alp-dt-th ${isSorted ? 'alp-dt-th--sorted' : ''} ${col.align ? 'alp-dt-th--' + col.align : ''}`}
                      style={colW ? `width:${colW};min-width:${colW}` : ''}>
                      <div class="alp-dt-th-inner" onclick={() => this.handleSort(col.key)}>
                        <span class="alp-dt-th-label">{col.label}</span>
                        <span class={`alp-dt-sort-icon ${isSorted ? 'alp-dt-sort-icon--active' : ''}`}>
                          {isSorted ? (this.sortDir === 'asc' ? '↑' : '↓') : '↕'}
                        </span>
                      </div>
                      <div class="alp-dt-resizer" onpointerdown={(e: PointerEvent) => this.startResize(e, col.key)}
                        title="Drag to resize"></div>
                    </th>
                  );
                })}

                {/* Options icon — last header column */}
                <th class="alp-dt-th alp-dt-th--options">
                  <div class="alp-dt-actions-wrap" style="position:relative;display:flex;align-items:center;justify-content:center;">
                    <button
                      class={`alp-dt-options-btn ${this.showActions ? 'alp-dt-options-btn--active' : ''}`}
                      onclick={() => { this.showActions = !this.showActions; this.showColumnMenu = false; this.showFilterMenu = false; }}
                      title="Table options"
                    >
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round" width="14" height="14">
                        <circle cx="12" cy="5" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="12" cy="19" r="1"/>
                      </svg>
                    </button>

                    {this.showActions ? (
                      <div class="alp-dt-actions-menu">
                        <button class={`alp-dt-menu-item ${this.showFilters ? 'alp-dt-menu-item--active' : ''}`}
                          onclick={() => { this.showFilters = !this.showFilters; if (!this.showFilters) { this.columnFilters = {}; this.filterCols = {}; } }}>
                          <svg viewBox="0 0 20 20" fill="currentColor" width="14" height="14">
                            <path fill-rule="evenodd" d="M3 3a1 1 0 011-1h12a1 1 0 011 1v3a1 1 0 01-.293.707L13 10.414V15a1 1 0 01-.553.894l-4 2A1 1 0 017 17v-6.586L3.293 6.707A1 1 0 013 6V3z" clip-rule="evenodd" />
                          </svg>
                          <span>{this.showFilters ? 'Disable Advanced Filtering' : 'Enable Advanced Filtering'}</span>
                        </button>
                        <div class="alp-dt-menu-divider"></div>
                        <button class="alp-dt-menu-item"
                          onclick={() => { this.showColumnMenu = !this.showColumnMenu; this.showFilterMenu = false; }}>
                          <svg viewBox="0 0 20 20" fill="currentColor" width="14" height="14">
                            <path d="M5 4a1 1 0 00-2 0v7.268a2 2 0 000 3.464V16a1 1 0 102 0v-1.268a2 2 0 000-3.464V4zM11 4a1 1 0 10-2 0v1.268a2 2 0 000 3.464V16a1 1 0 102 0V8.732a2 2 0 000-3.464V4zM16 3a1 1 0 011 1v7.268a2 2 0 010 3.464V16a1 1 0 11-2 0v-1.268a2 2 0 010-3.464V4a1 1 0 011-1z" />
                          </svg>
                          <span>Column Visibility</span>
                          <span class="alp-dt-menu-arrow">›</span>
                        </button>
                        <button class="alp-dt-menu-item" disabled={!this.showFilters}
                          onclick={() => { this.showFilterMenu = !this.showFilterMenu; this.showColumnMenu = false; }}>
                          <svg viewBox="0 0 20 20" fill="currentColor" width="14" height="14">
                            <path fill-rule="evenodd" d="M3 3a1 1 0 011-1h12a1 1 0 011 1v3a1 1 0 01-.293.707L13 10.414V15a1 1 0 01-.553.894l-4 2A1 1 0 017 17v-6.586L3.293 6.707A1 1 0 013 6V3z" clip-rule="evenodd" />
                          </svg>
                          <span>Filter Configuration</span>
                          <span class="alp-dt-menu-arrow">›</span>
                        </button>
                        <div class="alp-dt-menu-divider"></div>
                        <button class="alp-dt-menu-item" onclick={() => { this.handleExport(); this.showActions = false; }}>
                          <svg viewBox="0 0 20 20" fill="currentColor" width="14" height="14">
                            <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd" />
                          </svg>
                          <span>Export CSV</span>
                        </button>
                      </div>
                    ) : null}

                    {this.showColumnMenu ? (
                      <div class="alp-col-menu" onclick={(e: MouseEvent) => e.stopPropagation()}>
                        <div class="alp-col-menu-header">
                          <span>Column Visibility</span>
                          <button class="alp-col-menu-close" onclick={(e: MouseEvent) => { e.stopPropagation(); this.showColumnMenu = false; }}>×</button>
                        </div>
                        <div class="alp-col-menu-list">
                          {allCols.map(col => (
                            <label class="alp-col-menu-item" onclick={(e: MouseEvent) => e.stopPropagation()}>
                              <input type="checkbox" checked={!this.hiddenCols[col.key]}
                                onchange={(e: Event) => { e.stopPropagation(); this.toggleCol(col.key); }} />
                              <span>{col.label}</span>
                            </label>
                          ))}
                        </div>
                      </div>
                    ) : null}

                    {this.showFilterMenu ? (
                      <div class="alp-col-menu" onclick={(e: MouseEvent) => e.stopPropagation()}>
                        <div class="alp-col-menu-header">
                          <span>Select what to filter</span>
                          <button class="alp-col-menu-close" onclick={(e: MouseEvent) => { e.stopPropagation(); this.showFilterMenu = false; }}>×</button>
                        </div>
                        <div class="alp-col-menu-list">
                          {visCols.map(col => (
                            <label class="alp-col-menu-item" onclick={(e: MouseEvent) => e.stopPropagation()}>
                              <input type="checkbox" checked={this.filterCols[col.key] !== false}
                                onchange={(e: Event) => { e.stopPropagation(); const next = { ...this.filterCols }; next[col.key] = !next[col.key]; this.filterCols = next; }} />
                              <span>{col.label} Filter</span>
                            </label>
                          ))}
                        </div>
                      </div>
                    ) : null}
                  </div>
                </th>
              </tr>

              {this.showFilters ? (
                <tr class="alp-dt-filter-row">
                  <th class="alp-dt-th alp-dt-th--check"></th>
                  {visCols.map(col => {
                    const uniqueValues = Array.from(new Set((this.props.rows || []).map(r => r[col.key]).filter(v => v != null && v !== '')));
                    return (
                      <th class="alp-dt-filter-cell">
                        {this.filterCols[col.key] !== false ? (
                          <select class="alp-dt-filter-select" value={this.columnFilters[col.key] || ''}
                            onchange={(e: Event) => this.handleColumnFilter(col.key, e.target.value)}>
                            <option value="">All {col.label}</option>
                            {uniqueValues.sort().map(val => <option value={String(val)}>{String(val)}</option>)}
                          </select>
                        ) : null}
                      </th>
                    );
                  })}
                  <th class="alp-dt-th alp-dt-th--options"></th>
                </tr>
              ) : null}
            </thead>

            <tbody>
              {isLoading ? (
                [0,1,2,3,4,5].map(() => (
                  <tr class="alp-dt-row">
                    <td class="alp-dt-td alp-dt-td--check"><span class="alp-dt-skeleton alp-dt-skeleton--sm"></span></td>
                    {visCols.map(() => <td class="alp-dt-td"><span class="alp-dt-skeleton"></span></td>)}
                    <td class="alp-dt-td alp-dt-td--options"></td>
                  </tr>
                ))
              ) : pageRows.length === 0 ? (
                <tr>
                  <td class="alp-dt-empty" colspan={colCount + 1}>
                    <div class="alp-dt-empty-inner">
                      <div class="alp-dt-empty-icon">📂</div>
                      <div class="alp-dt-empty-title">{this.props.emptyTitle || 'No data found'}</div>
                      <div class="alp-dt-empty-desc">{this.props.emptyDescription || 'There are no records to display.'}</div>
                    </div>
                  </td>
                </tr>
              ) : pageRows.map(row => {
                const sel = this.isSelected(row);
                return (
                  <tr class={`alp-dt-row ${sel ? 'alp-dt-row--selected' : ''} ${this.props.onRowClick ? 'alp-dt-row--clickable' : ''}`}
                    onclick={() => this.props.onRowClick && this.props.onRowClick(row)}>
                    <td class="alp-dt-td alp-dt-td--check" onclick={(e: Event) => e.stopPropagation()}>
                      <input type="checkbox" class="alp-dt-checkbox" checked={sel} onchange={() => this.toggleRow(row)} />
                    </td>
                    {visCols.map(col => (
                      <td class={`alp-dt-td ${col.align ? 'alp-dt-td--' + col.align : ''}`}>
                        {col.render ? col.render(row[col.key], row) : (row[col.key] != null ? String(row[col.key]) : '—')}
                      </td>
                    ))}
                    <td class="alp-dt-td alp-dt-td--options" onclick={(e: Event) => e.stopPropagation()}></td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>


      </div>
    );
  }
}
