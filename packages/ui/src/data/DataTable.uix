import { SwissComponent } from '@swissjs/core';
import EmptyState from '../feedback/EmptyState.ui';
import DataExport from './DataExport.ui';

component DataTable {
  props = {
    columns: Array as () => Array<{ key: string; label: string; sortable?: boolean; width?: string }>,
    rows: Array as () => Array<Record<string, any>>,
    loading: Boolean,
    selectable: Boolean,
    onRowClick: Function as (row: Record<string, any>) => void,
    onSelectionChange: Function as (selected: any[]) => void,
    exportable: Boolean,
    searchable: Boolean,
  };

  state { let sortKey: string = ''; }
  state { let sortDir: string = 'asc'; }
  state { let searchQuery: string = ''; }
  state { let selectedIds: string[] = []; }
  state { let currentPage: number = 1; }
  state { let rowsPerPage: number = 10; }

  handleSort(key: string) {
    if (this.sortKey === key) {
      this.sortDir = this.sortDir === 'asc' ? 'desc' : 'asc';
    } else {
      this.sortKey = key;
      this.sortDir = 'asc';
    }
    this.scheduleUpdate?.();
  }

  handleSearch(e: Event) {
    this.searchQuery = (e.target as HTMLInputElement).value;
    this.currentPage = 1;
    this.scheduleUpdate?.();
  }

  handleSelectAll(e: Event, currentRows: Array<Record<string, any>>) {
    const checked = (e.target as HTMLInputElement).checked;
    if (checked) {
      this.selectedIds = currentRows.map(r => r.id || r.sku || r.key || JSON.stringify(r));
    } else {
      this.selectedIds = [];
    }
    this.scheduleUpdate?.();
    if (this.props.onSelectionChange) this.props.onSelectionChange(this.selectedIds);
  }

  handleSelectRow(e: Event, row: Record<string, any>) {
    const checked = (e.target as HTMLInputElement).checked;
    const rowId = row.id || row.sku || row.key || JSON.stringify(row);
    if (checked) {
      this.selectedIds = [...this.selectedIds, rowId];
    } else {
      this.selectedIds = this.selectedIds.filter(id => id !== rowId);
    }
    this.scheduleUpdate?.();
    if (this.props.onSelectionChange) this.props.onSelectionChange(this.selectedIds);
  }

  changePage(delta: number) {
    this.currentPage += delta;
    this.scheduleUpdate?.();
  }

  changeRowsPerPage(e: Event) {
    this.rowsPerPage = parseInt((e.target as HTMLSelectElement).value, 10);
    this.currentPage = 1;
    this.scheduleUpdate?.();
  }

  render() {
    const columns = Array.isArray(this.props.columns) ? this.props.columns : [];
    const allRows = Array.isArray(this.props.rows) ? this.props.rows : [];
    const isLoading = !!this.props.loading;
    const isSelectable = !!this.props.selectable;
    const isSearchable = !!this.props.searchable;
    const isExportable = !!this.props.exportable;

    // Filter
    let processedRows = allRows;
    if (isSearchable && this.searchQuery) {
      const q = this.searchQuery.toLowerCase();
      processedRows = processedRows.filter(row => {
        return columns.some(col => String(row[col.key] || '').toLowerCase().includes(q));
      });
    }

    // Sort
    if (this.sortKey) {
      processedRows = [...processedRows].sort((a, b) => {
        const valA = a[this.sortKey];
        const valB = b[this.sortKey];
        if (valA < valB) return this.sortDir === 'asc' ? -1 : 1;
        if (valA > valB) return this.sortDir === 'asc' ? 1 : -1;
        return 0;
      });
    }

    // Paginate
    const totalRows = processedRows.length;
    const totalPages = Math.ceil(totalRows / this.rowsPerPage);
    const startIndex = (this.currentPage - 1) * this.rowsPerPage;
    const paginatedRows = processedRows.slice(startIndex, startIndex + this.rowsPerPage);

    const isEmpty = !isLoading && paginatedRows.length === 0;
    const hasData = !isLoading && paginatedRows.length > 0;
    const allSelected = hasData && paginatedRows.every(r => this.selectedIds.includes(r.id || r.sku || r.key || JSON.stringify(r)));
    const colSpan = columns.length + (isSelectable ? 1 : 0);

    return (
      <div>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
          {isSearchable ? (
            <input
              type="text"
              class="aui-input aui-table-search"
              placeholder="Search..."
              value={this.searchQuery}
              oninput={(e: Event) => this.handleSearch(e)}
            />
          ) : <div></div>}
          
          {isExportable ? (
            <DataExport 
              data={processedRows} 
              columns={columns.map(c => ({ key: c.key, label: c.label }))} 
              filename="export" 
            />
          ) : null}
        </div>

        <div class="aui-table-container">
          <table class="aui-table">
            <thead>
              <tr>
                {isSelectable ? (
                  <th style="width: 40px; text-align: center;">
                    <input
                      type="checkbox"
                      checked={allSelected}
                      onchange={(e: Event) => this.handleSelectAll(e, paginatedRows)}
                    />
                  </th>
                ) : null}
                {columns.map(col => (
                  <th
                    style={col.width ? `width: ${col.width}` : ''}
                    onclick={() => col.sortable && this.handleSort(col.key)}
                  >
                    {col.label}
                    {col.sortable ? (
                      <span class="aui-sort-icon">
                        {this.sortKey === col.key ? (this.sortDir === 'asc' ? '↑' : '↓') : '↕'}
                      </span>
                    ) : null}
                  </th>
                ))}
              </tr>
            </thead>

            {isLoading ? (
              <tbody>
                {[0, 1, 2, 3, 4].map(() => (
                  <tr class="aui-table-row">
                    <td colspan={colSpan} style="padding: 1rem;">
                      <div style="height: 20px; background: var(--alabaster-grey); border-radius: 4px; animation: pulse 1.5s infinite;"></div>
                    </td>
                  </tr>
                ))}
              </tbody>
            ) : null}

            {isEmpty ? (
              <tbody>
                <tr>
                  <td colspan={colSpan} style="padding: 0;">
                    <EmptyState 
                      icon="📁" 
                      title="No data found" 
                      description={this.searchQuery ? "Try adjusting your search query." : "There are no records to display."} 
                    />
                  </td>
                </tr>
              </tbody>
            ) : null}

            {hasData ? (
              <tbody>
                {paginatedRows.map(row => {
                  const rowId = row.id || row.sku || row.key || JSON.stringify(row);
                  const isSelected = this.selectedIds.includes(rowId);
                  return (
                    <tr 
                      class={`aui-table-row${isSelected ? ' aui-table-row--selected' : ''}`}
                      onclick={() => this.props.onRowClick && this.props.onRowClick(row)}
                      style={this.props.onRowClick ? 'cursor: pointer;' : ''}
                    >
                      {isSelectable ? (
                        <td style="text-align: center;" onclick={(e: Event) => e.stopPropagation()}>
                          <input
                            type="checkbox"
                            checked={isSelected}
                            onchange={(e: Event) => this.handleSelectRow(e, row)}
                          />
                        </td>
                      ) : null}
                      {columns.map(col => (
                        <td>{row[col.key] !== undefined && row[col.key] !== null ? String(row[col.key]) : '—'}</td>
                      ))}
                    </tr>
                  );
                })}
              </tbody>
            ) : null}
          </table>
        </div>

        {hasData ? (
          <div class="aui-pagination">
            <div style="color: var(--dusty-denim); font-size: 0.875rem;">
              Showing {startIndex + 1}-{Math.min(startIndex + this.rowsPerPage, totalRows)} of {totalRows}
            </div>
            
            <div style="display: flex; align-items: center; gap: 1rem;">
              <select 
                class="aui-input" 
                style="padding: 0.25rem; width: auto;"
                onchange={(e: Event) => this.changeRowsPerPage(e)}
              >
                {[10, 25, 50, 100].map(val => (
                  <option value={val.toString()} selected={this.rowsPerPage === val}>{val} / page</option>
                ))}
              </select>
              
              <div style="display: flex; gap: 0.25rem;">
                <button 
                  class="aui-btn" 
                  disabled={this.currentPage === 1}
                  onclick={() => this.changePage(-1)}
                  style={this.currentPage === 1 ? 'opacity: 0.5; cursor: not-allowed;' : ''}
                >Prev</button>
                <button 
                  class="aui-btn" 
                  disabled={this.currentPage >= totalPages}
                  onclick={() => this.changePage(1)}
                  style={this.currentPage >= totalPages ? 'opacity: 0.5; cursor: not-allowed;' : ''}
                >Next</button>
              </div>
            </div>
          </div>
        ) : null}
      </div>
    );
  }
}
