import { SwissComponent } from '@swissjs/core';

component IconButton {
  props = {
    // Must be a developer-controlled SVG string — never pass user-derived content.
    icon: String,
    variant: String,
    size: String,
    disabled: Boolean,
    loading: Boolean,
    onclick: Function,
    title: String,
    class: String,
  };

  sanitizeIcon(svg: string): string {
    return svg
      .replace(/\son\w+\s*=\s*["'][^"']*["']/gi, '')
      .replace(/<script[\s\S]*?<\/script>/gi, '');
  }

  render() {
    const variant = this.props.variant || 'ghost';
    const size    = this.props.size    || 'md';
    const isDisabled = !!(this.props.disabled || this.props.loading);
    const extraClass = this.props.class || '';

    return (
      <button
        type="button"
        class={`alp-btn alp-btn--${variant} alp-btn--${size} alp-icon-btn ${extraClass}`}
        disabled={isDisabled}
        title={this.props.title}
        onclick={(e: any) => !isDisabled && this.props.onclick && this.props.onclick(e)}
        style="padding:0;width:32px;"
      >
        {this.props.loading ? (
          <span class="alp-btn-spinner" aria-hidden="true"></span>
        ) : (
          <span style="display:flex;align-items:center;justify-content:center;" innerHTML={this.sanitizeIcon(this.props.icon || '')}></span>
        )}
      </button>
    );
  }
}
